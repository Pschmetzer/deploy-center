<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.deploycenter.ios.refresh</string>
		<string>app.deploycenter.ios.follow.*</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.deploycenter.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>deploycenter</string>
			</array>
		</dict>
	</array>
	<key>DCKeychainGroup</key>
	<string>$(DEVELOPMENT_TEAM).app.deploycenter.shared</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>app.deploycenter.project</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
