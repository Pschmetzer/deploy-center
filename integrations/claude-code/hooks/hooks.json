{
  "description": "After a git push, one read-only line: what is waiting to go live (deploys changed). Optional: the same at session start.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/after-push.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/after-push.sh\" --session-start",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
