{
  "name": "deploy-center",
  "displayName": "Deploy Center",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "deploycenter",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://deploycenter.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pschmetzer/deploy-center",
    "directory": "integrations/vscode"
  },
  "bugs": {
    "url": "https://github.com/Pschmetzer/deploy-center/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "deploy",
    "vercel",
    "render",
    "cursor",
    "claude code"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Deploy Center runs git in the open folder to match it to your projects."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "deployCenter.refresh",
        "title": "%command.refresh%",
        "category": "Deploy Center",
        "icon": "$(refresh)"
      },
      {
        "command": "deployCenter.menu",
        "title": "%command.menu%",
        "category": "Deploy Center"
      },
      {
        "command": "deployCenter.deployRepo",
        "title": "%command.deployRepo%",
        "category": "Deploy Center",
        "icon": "$(rocket)"
      },
      {
        "command": "deployCenter.deployProject",
        "title": "%command.deployProject%",
        "category": "Deploy Center",
        "icon": "$(rocket)"
      },
      {
        "command": "deployCenter.deployPreview",
        "title": "%command.deployPreview%",
        "category": "Deploy Center",
        "icon": "$(eye)"
      },
      {
        "command": "deployCenter.rollback",
        "title": "%command.rollback%",
        "category": "Deploy Center",
        "icon": "$(history)"
      },
      {
        "command": "deployCenter.openSite",
        "title": "%command.openSite%",
        "category": "Deploy Center",
        "icon": "$(link-external)"
      },
      {
        "command": "deployCenter.openDashboard",
        "title": "%command.openDashboard%",
        "category": "Deploy Center"
      },
      {
        "command": "deployCenter.showLog",
        "title": "%command.showLog%",
        "category": "Deploy Center",
        "icon": "$(output)"
      },
      {
        "command": "deployCenter.copyForAi",
        "title": "%command.copyForAi%",
        "category": "Deploy Center",
        "icon": "$(copy)"
      },
      {
        "command": "deployCenter.copyNotes",
        "title": "%command.copyNotes%",
        "category": "Deploy Center"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "deployCenter.projects",
          "name": "Deploy Center",
          "icon": "$(rocket)",
          "contextualTitle": "Deploy Center"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "deployCenter.projects",
        "contents": "%welcome.missing%",
        "when": "deployCenter.state == missing"
      },
      {
        "view": "deployCenter.projects",
        "contents": "%welcome.empty%",
        "when": "deployCenter.state == empty"
      },
      {
        "view": "deployCenter.projects",
        "contents": "%welcome.nomatch%",
        "when": "deployCenter.state == nomatch"
      },
      {
        "view": "deployCenter.projects",
        "contents": "%welcome.error%",
        "when": "deployCenter.state == error"
      },
      {
        "view": "deployCenter.projects",
        "contents": "%welcome.loading%",
        "when": "!deployCenter.state || deployCenter.state == loading"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deployCenter.refresh",
          "when": "view == deployCenter.projects",
          "group": "navigation"
        },
        {
          "command": "deployCenter.deployRepo",
          "when": "view == deployCenter.projects && deployCenter.repoWaiting",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "deployCenter.deployProject",
          "when": "view == deployCenter.projects && viewItem =~ /waiting/",
          "group": "inline"
        },
        {
          "command": "deployCenter.copyForAi",
          "when": "view == deployCenter.projects && viewItem =~ /failed/",
          "group": "inline"
        },
        {
          "command": "deployCenter.deployProject",
          "when": "view == deployCenter.projects && viewItem =~ /project/",
          "group": "1_deploy"
        },
        {
          "command": "deployCenter.deployPreview",
          "when": "view == deployCenter.projects && viewItem =~ /can-preview/",
          "group": "1_deploy@2"
        },
        {
          "command": "deployCenter.rollback",
          "when": "view == deployCenter.projects && viewItem =~ /can-rollback/",
          "group": "1_deploy@3"
        },
        {
          "command": "deployCenter.openSite",
          "when": "view == deployCenter.projects && viewItem =~ /project/",
          "group": "2_open@1"
        },
        {
          "command": "deployCenter.openDashboard",
          "when": "view == deployCenter.projects && viewItem =~ /project/",
          "group": "2_open@2"
        },
        {
          "command": "deployCenter.showLog",
          "when": "view == deployCenter.projects && viewItem =~ /project/",
          "group": "3_log@1"
        },
        {
          "command": "deployCenter.copyForAi",
          "when": "view == deployCenter.projects && viewItem =~ /project/",
          "group": "3_log@2"
        },
        {
          "command": "deployCenter.copyNotes",
          "when": "view == deployCenter.projects && viewItem =~ /project/",
          "group": "4_notes"
        }
      ],
      "commandPalette": [
        {
          "command": "deployCenter.deployProject",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Deploy Center",
      "properties": {
        "deployCenter.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.cliPath.markdownDescription%"
        },
        "deployCenter.scope": {
          "type": "string",
          "enum": [
            "auto",
            "repo",
            "all"
          ],
          "enumDescriptions": [
            "%config.scope.enum.auto%",
            "%config.scope.enum.repo%",
            "%config.scope.enum.all%"
          ],
          "default": "auto",
          "description": "%config.scope.description%"
        },
        "deployCenter.pollMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "%config.pollMinutes.description%"
        },
        "deployCenter.timeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "description": "%config.timeoutSeconds.description%"
        },
        "deployCenter.logLines": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "description": "%config.logLines.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs --tests && node --test \"out/test/*.test.js\"",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "ovsx": "1.2.0",
    "typescript": "7.0.2"
  },
  "l10n": "./l10n"
}
