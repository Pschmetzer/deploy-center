<?xml version="1.0" encoding="UTF-8"?>
<!-- Example: every day at 18:00 deploy what is merged and not live. Copy to ~/Library/LaunchAgents/,
     replace YOURNAME, then: launchctl load ~/Library/LaunchAgents/app.deploycenter.daily.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>app.deploycenter.daily</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>/Users/YOURNAME/bin/deploys</string><string>deploy-changed</string><string>--yes</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/deploy-center-daily.log</string>
  <key>StandardErrorPath</key><string>/tmp/deploy-center-daily.log</string>
</dict></plist>
