        echo "complete -c deploys -n '__fish_seen_subcommand_from ai' -a 'explain notes ship set-key forget-key verify model cap status'"
        echo "complete -c deploys -n '__fish_seen_subcommand_from providers' -a 'enable disable'"
        echo "complete -c deploys -n '__fish_seen_subcommand_from completion' -a 'zsh bash fish'"
        printf "complete -c deploys -n 'not __fish_use_subcommand' -a '(cat %s 2>/dev/null)'\n" "$(printf '%q' "$CONFIG_DIR/names")" ;;
