          esac
        done <<< "$todo"
        todo="${next%$'\n'}"
        [ -n "$todo" ] || break
        el=$(( SECONDS - t0 )); [ "$el" -lt 5 ] || waited=$(( waited + el ))   # slow answers only: a second of rounding is no wait
        [ $((waited + delay)) -le "$maxw" ] || delay=$(( maxw - waited )); [ "$delay" -ge 0 ] || delay=0
        [ "$json" = 1 ] || echo "Waiting for checks on $(echo "$todo" | cut -f2 | paste -sd, - | sed 's/,/, /g'); next look in ${delay}s." >&2
        sleep "$delay"; waited=$((waited + delay)); delay=$(( delay * 2 > 120 ? 120 : delay * 2 ))
      done
    fi
    if [ "$json" = 1 ]; then jq -s '.' "$res"
    else echo "$ok started, $bad failed to start$([ -n "$green" ] && echo ", $skip skipped")."; fi
    rm -f "$res"
    [ "$rc" = 0 ] || echo "Some projects could not be read and were left out (see above)." >&2
    [ "$bad" = "0" ] && [ "$rc" = 0 ] || exit 1
    [ -z "$strict" ] || [ "$skip" = 0 ] || exit 2 ;;

