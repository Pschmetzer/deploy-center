          || echo '{"at":null,"args":[],"scheduled":false,"pathMissing":[]}')"
        if [ "$json" = 1 ]; then echo "$st"
        else echo "$st" | jq -r 'if .at then "daily at \(.at)\(if (.args | length) > 0 then " (\(.args | join(" ")))" else "" end): \(if .scheduled then "on" else "set, but launchd has no job (deploys schedule daily again)" end)" else "off" end'; fi ;;
      *) die "Usage: deploys schedule daily [HH:MM] [--when-green] [--by-rules] [--strict] | off | status [--json]" ;;
    esac ;;

  "rules "*) declare -F rules_main >/dev/null || die "lib/rules.sh is not next to deploys."; rules_main "${@:2}" ;;
  "price "*) load_savings; price_main "${@:2}" ;;
  "budget "*) load_savings; budget_main "${@:2}" ;;

  "gitlab "*)
    # gitlab set-token: a GitLab token (read_api) from stdin into the keychain, instead of a
    # GITLAB_TOKEN in the shell profile. Tried on $(gitlab_host) first: a typo replaces nothing.
    # GITLAB_TOKEN, when set, still wins (docs/GITLAB.md).
    declare -F gitlab_token >/dev/null || die "GitLab needs lib/githost.sh next to deploys"
    case "${2:-}" in
      set-token)
        IFS= read -r key || true
        # A token copied with a CR (Windows) or spaces around it: trimmed; spaces, quotes or a backslash inside are refused.
        key="$(printf "%s" "$key" | tr -d "\r" | sed "s/^[[:space:]]*//; s/[[:space:]]*\$//")"
        [ -n "$key" ] || die "Pipe the token in: pbpaste | deploys gitlab set-token"
        case "$key" in *\'*|*\"*|*\\*|*[[:space:]]*|*[[:cntrl:]]*) die "That does not look like a GitLab token (glpat-...)";; esac
        ( GITLAB_TOKEN="$key" DEPLOYS_GITLAB_CURL=1 gitlab_api "$(gitlab_host)" user >/dev/null 2>&1 ) \
          || die "$(gitlab_host) did not accept that token; nothing was saved"
        # On stdin to `security -i`: the token is never an argument anyone can see.
        printf 'add-generic-password -U -a %s -s %s -w %s\n' "$USER" "$GITLAB_KEYCHAIN" "$key" | security -i >/dev/null \
          || die "The token works, but could not be saved in the keychain"
        echo "GitLab token for $(gitlab_host) saved and working."
        [ -z "${GITLAB_TOKEN:-}" ] || echo "Note: GITLAB_TOKEN is set in this shell and wins over the keychain. Remove it from your shell profile." ;;
      forget-token)
        security delete-generic-password -a "$USER" -s "$GITLAB_KEYCHAIN" >/dev/null 2>&1 && echo "GitLab token removed." || echo "No GitLab token was saved." ;;
      *) die "Usage: pbpaste | deploys gitlab set-token | deploys gitlab forget-token" ;;
    esac ;;

  *)
    if is_provider "${1:-}"; then provider_cmd "$@"; exit $?; fi
    [ -z "${1:-}" ] || echo "Error: unknown command \"$1\". The commands:" >&2
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac