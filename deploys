        started) if [ "$(echo "$st" | jq -r '.url // empty')" != "" ]; then echo "$P: $name started -> $(echo "$st" | jq -r .url)"; else echo "$P: $name started ($(echo "$st" | jq -r .id))"; fi ;;
        failed) echo "$P: $name failed to start" >&2 ;;
        skipped) echo "$P: $name skipped: $why" ;;
      esac
    }
    start() {  # start <platform> <name> <sha or empty> <reason>
      local st
      if st="$(deploy_one "$1" "$2" "$3" "${5:-}" </dev/null)"; then ok=$((ok+1)); say "$1" "$2" started "$4" "$(echo "$st" | jq -c .)"; journal_forced "$1" "$2"
      else bad=$((bad+1)); say "$1" "$2" failed "$4"; fi
    }
    todo="$(echo "$list" | jq -r '.[] | "\(.platform)\t\(.name)\t\(.id // "-")\t\(.repo // "")\t\(.headSha // "")"')"
    if [ -z "$green" ]; then
      while IFS=$'\t' read -r plat name id _ _; do start "$plat" "$name" "" "" "$id"; done <<< "$todo"
    else
      # Every project is asked in rounds, so one slow CI does not hold up the others; each starts
      # as soon as its own commit is green, at exactly that commit (a newer push waits for the next run).
      waited=0; delay=10
      while [ -n "$todo" ]; do
        t0=$SECONDS   # the asking (and starting) counts toward --wait too
        next=""
        while IFS=$'\t' read -r plat name id repo sha; do
          if [ -z "$repo" ] || [ -z "$sha" ]; then skip=$((skip+1)); say "$plat" "$name" skipped "the commit or repo is unknown, so its checks are too"; continue; fi
          v="$(ci_of "$repo" "$sha" </dev/null)"; s="$(echo "$v" | jq -r .state)"; why="$(echo "$v" | jq -r .reason)"
          case "$s" in
