        --path) path="${2:?Usage: deploys verify <project> --path /health}"; shift ;;
        --rollback-after) after="${2:-}"; shift ;;
        --no-rollback) norb=1 ;;
        --url) url="${2:?Usage: deploys verify <project> --url https://…}"; shift ;;
