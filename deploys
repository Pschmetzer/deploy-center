#!/bin/bash
# deploys — turn off auto-deploy on Vercel, Render and the other platforms in providers/
# (deploys providers), then deploy by hand.
#
# Why: every git push builds every project. Build minutes cost money.
# Deploying once a day by hand costs a fraction.
#
# Access:
#   Vercel  the `vercel` CLI login on this Mac (`vercel login`).
#   Render  an API key in the macOS keychain (`deploys render set-key`, reads stdin).
# No key is ever printed.
#
# Commands:
#   deploys doctor                            check tools and access (JSON)
#   deploys changed [--json]                  what has commits on GitHub that are not live
#   deploys deploy-changed [--yes]            deploy all of those (shows the list without --yes)
#     [--by-rules]                            only what a "deploy" rule matches; "hold" rules always count
#     [--when-green [--wait 30m] [--strict]]  only commits whose CI passed; waits for running checks
#   deploys schedule daily [HH:MM] [--when-green] [--by-rules] [--strict] | off | status [--json]
#                                             deploy-changed --yes once a day (launchd; else the cron line)
#   deploys rules check [--json]              which rule of rules.json matches which waiting project, and why not
#   deploys plan [--when-green] [--json]      what deploy-changed --yes would start, and an estimate of its cost
#   deploys deploy <project> [--sha <c>]      deploy one project to production (Vercel or Render)
#   deploys verify <p> [--path /health]       after a deploy: ask the site 3 times; on 5xx or no answer
#     [--rollback-after 10] [--no-rollback]   count down, then roll back (Ctrl-C stops it)
#     [--expect 200|2xx] [--follow]          only that status is healthy; follow up to 3 redirects
#   deploys risk <project> [--json]           green/yellow/red for what waits: migrations, lockfiles, config, size
#   deploys ci <owner/repo> [<ref>] [--wait 30m]  the CI verdict of a commit: green, pending, red, none
#   deploys window [--json]                   is the deploy window (window.json) open now?
#   --force "why"                             deploy inside a closed window; the reason goes to the journal
#   deploys status [--watch] [--no-github]    what is building or failed (--no-github: no GitHub calls)
#   deploys watch <p> [<id>] [--preview]      follow a deploy until it is live or failed
#     [--timeout 30m]                         give up after that long (exit 4; the deploy goes on)
#   deploys explain <project>                 why a project is (not) counted as changed
#   deploys diff <project>                    commits and files between what is live and the branch
#   deploys notes <project> [--json]          the same as release notes (Markdown; --json: author as a field)
#   deploys vercel map <p> <owner/repo> [br]  say where a project deploys from
#                                             (GitLab: gitlab.com/group/name, see docs/GITLAB.md)
#   deploys vercel list                       projects and whether a push still deploys them
#   deploys vercel autodeploy-off <p>|--all   disconnect Git (remembers the repo first)
#   deploys vercel autodeploy-on <p>|--all    connect Git again from the remembered repo (pushes build again)
#   deploys vercel rollback <p>               production back to the previous deployment
#   deploys render rollback <service>          back to the deploy that was live before
#   deploys vercel team [<id>]                show or set the Vercel team
#   deploys vercel deploy <p> [--preview] [--sha <c>] [--wait]   the newest commit of the remembered repo;
#                                             --wait follows it until live or failed
#   deploys history <project> [n] [--json]    the last n deploys (default 10): when, state, commit, source
#   deploys logs <project> [lines] [--id <d>] the end of the newest build log (or of deploy <d>), keys masked
#     [--runtime]                             the running service's log instead (providers with runtimeLogs)
#   deploys autofix [--dry-run] [--only <platform> <p> [--again]]   a failed build goes to a Claude Code routine, which opens a fix PR (never deploys)
#   deploys autofix --preview --only <platform> <p> [--json]   what a fire would send (masked log, prompt, routine id); sends nothing
#   deploys autofix set-token | routine <id> | list | forget-token | prompt | status | sync | schedule on|off
#   deploys scan start <owner/repo> [branch]  Claude Code on this Mac looks for bugs and opens one fix PR (never merges)
#   deploys scan status [--json] | list | log <id>   the newest scans, their PRs and reports
#   deploys scan start <owner/repo> [branch] --findings <check id>   the same, on what a check found
#   deploys check start <owner/repo> [branch] OSV-Scanner, gitleaks and Semgrep (free, local, read-only)
#   deploys check show <id>                   the findings of one check (secrets redacted)
#                                             (see docs/AUTOFIX.md)
#   deploys ai explain|notes|ship <p>         ask Claude (your own Anthropic key): why a build failed,
#                                             plain release notes (--lang en|de), is it safe to ship
#   deploys ai ask <p> --question "…"         your own question about a project (its commits and log go along)
#   deploys ai slow <p> | risk <p>            why its builds take long; risk = ship
#   deploys ai set-key | verify | model [<id>] | cap [<n>] | status | forget-key   (see docs/CLAUDE.md)
#   deploys open <project> [--dashboard]      the site, or its page at Vercel or Render
#   deploys ignore <p> [--undo] | --list      leave a project out of changed and deploy-changed
#   deploys costs [days] | triggers           Vercel charges per day; builds nobody started from here
#   deploys simulate [--days 30] [--json]     estimate: what auto-deploy costs a month vs. once a day
#   deploys ledger [--json]                   estimate: builds skipped and money saved since auto-deploy was off
#   deploys price [set <vercel|render> <usd> | unset <p>]   your price of one build minute (prices.json)
#   deploys budget [set <usd a month> [--strict] | off]     deploy-changed --yes stops before going over it
#   deploys where                             config folder, version, key source, logins
#   deploys render forget-key                 remove the Render key from the keychain
#   deploys completion zsh|bash|fish          tab completion (eval "$(deploys completion zsh)";
#                                             fish: deploys completion fish | source)
#   deploys <command> --help                  the help lines of one command
#   deploys list [--json]                     every project on every provider that is on, with its platform
#   deploys providers [--json]                the platforms (providers/*.sh): on or off, set up or not
#   deploys providers enable|disable <p>      switch one on or off (Vercel and Render are on by default)
#   deploys <p> <verb> ...                    any provider: json, deploy-json, status, latest, logs, url, ...
#                                             (docs/PROVIDERS.md); a name may be written <p>:<name>
#   deploys deploy <p>|<group> [--preview] [--sha <c>] [--wait] [--force "reason"]
#                                             deploy one project, or a group in its order (docs/TEAM.md)
#   deploys config [--json] [--refresh]       the effective config, and where each value came from
#   deploys team add|remove <owner/repo> | list | refresh | journal   repos whose deploy-center.json counts
#   deploys team init <owner/repo>            print a deploy-center.json for that repo from this Mac's settings (writes nothing)
#   deploys hooks install|uninstall|status [<repo>]  the pre-push check (integrations/hooks) in a repo,
#                                             after a pre-push that is there already (core.hooksPath counts)
#   deploys readonly [on|off]                 observer mode: commands that change something are refused
#                                             (a guard against slips, not access control: docs/TEAM.md)
#   deploys --help | --version
#   deploys render list                       services and their auto-deploy setting
#   deploys render autodeploy-off <s>|--all
#   deploys render autodeploy-on <s>|--all    auto-deploy "On Commit" again
#   deploys autodeploy allow <platform|all> <p>|--all <hours>   auto-deploy on for a while (1-168 h)
#   deploys autodeploy allowed [--json] | revoke <platform|all> <p>|--all
#   deploys guard [--dry-run]                 auto-deploy off wherever it is on without an allowance
#   deploys guard status [--json] | schedule on|off   (every 30 minutes; see docs/GUARD.md)
#   deploys render deploy <service>           deploy the newest commit
#   deploys render set-key                    store the Render API key (read from stdin)
#   deploys gitlab set-token | forget-token   a GitLab token in the keychain (read from stdin; docs/GITLAB.md)
#
# Exit codes: 0 done (also "nothing to deploy"), 1 an error, something failed to start, or the
# state of some project could not be read (it is named and left out, never counted as current).
# Per command (docs/CLI.md has the table):
#   watch            0 live, 1 failed or canceled, 3 the platform could not be asked, 4 --timeout
#   verify           0 healthy, 1 failed and rolled back, 2 failed and not rolled back
#   ci               0 green or no checks, 1 red, 2 still pending or GitHub not reachable
#   window           0 open, 1 closed
#   deploy-changed   with --strict also 2 when something was skipped (red or pending CI)
#   autofix --only   2 not failed, 3 handed over already or busy, 4 a cap, 5 no routine, 6 locked
#   deploy           with --wait or a group, 3 started but its deploy id is unknown (not followed)
#
# Config lives in ${DEPLOYS_CONFIG:-~/.config/deploys}:
#   vercel-repos.json  which repo/branch each Vercel project deploys from
#   vercel-team        team id (auto-detected; empty for a personal account)
#   providers.json     which providers are on, when changed with `deploys providers`
#   prices.json        your price of one build minute, where no billing says it (deploys price)
#   rules.json         "when … then …" for the daily deploy (the app's rule editor; docs/CLI.md)
#   budget.json        {"monthlyUsd":50,"strict":false}: the budget brake (deploys budget)
#   window.json        when deploys are closed: {"deny":[{"days":["fri"],"from":"15:00"}]} (docs/SAFE-DEPLOY.md)
#   overrides.json     this Mac's overrides of the shared deploy-center.json (docs/TEAM.md)
#   readonly           present: observer mode (as DEPLOYS_READONLY=1)

set -euo pipefail

CONFIG_DIR="${DEPLOYS_CONFIG:-$HOME/.config/deploys}"
REPOS="$CONFIG_DIR/vercel-repos.json"
# launchd and cron start without $USER; under set -u the keychain lookups would stop the script.
USER="${USER:-$(id -un)}"
# Locks, the remembered repos and (for a moment) the Render key live here: for this user only.
# Only a folder made here is closed to others: a DEPLOYS_CONFIG someone set keeps its rights. A
# config that cannot be written (a container, a CI cache) still lets reading commands run.
if [ ! -d "$CONFIG_DIR" ]; then mkdir -p "$CONFIG_DIR" 2>/dev/null && chmod 700 "$CONFIG_DIR" 2>/dev/null || true
elif [ -z "${DEPLOYS_CONFIG:-}" ]; then chmod 700 "$CONFIG_DIR" 2>/dev/null || true; fi
[ -f "$REPOS" ] || { echo '{}' > "$REPOS"; } 2>/dev/null || true

# BSD (macOS) and GNU (Linux) spell file times, date maths and base64 differently.
# GNU first: GNU `stat -f` is the file system's status, and answers something that is no time.
mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1"; }

# A lock (file or folder) older than <seconds> is taken away, and only that one: it is renamed
# to a name of its own first (one rename wins), and if what was moved is not the stale lock that
# was judged (a new holder made it in between), it is given back without ever overwriting one.
lock_clear_stale() {  # lock_clear_stale <path> <seconds>
  local f="$1" m t; [ -e "$f" ] || return 0
  m="$(mtime "$f" 2>/dev/null)" || return 0
  [ $(( $(date +%s) - m )) -ge "$2" ] || return 0
  t="$f.stale.$$.$RANDOM"
  mv "$f" "$t" 2>/dev/null || return 0
  if [ "$(mtime "$t" 2>/dev/null)" = "$m" ]; then rm -rf "$t"; return 0; fi
  if [ -d "$t" ]; then mkdir "$f" 2>/dev/null; rmdir "$t" 2>/dev/null || true
  else ln "$t" "$f" 2>/dev/null; rm -f "$t"; fi
  return 0
}
# A short lock for a small file that two runs may rewrite at once (counts, lists): waited for two
# seconds at most, taken over after <stale> seconds (0: never), and without it the write still
# happens (as before). No trap: callers unlock themselves, so AF_RUN_LOCK's trap stays theirs.
file_lock() {  # file_lock <file> [stale seconds, default 10]; then file_unlock <file>
  local i=0
  [ "${2:-10}" = 0 ] || lock_clear_stale "$1.lock" "${2:-10}"
  while [ "$i" -lt 20 ]; do mkdir "$1.lock" 2>/dev/null && return 0; i=$((i + 1)); sleep 0.1; done
  return 1
}
file_unlock() { rmdir "$1.lock" 2>/dev/null || true; }
export -f mtime   # team_fetch_one runs under xargs
# A file name for a key like owner/repo@ref: "/" and "@" become "_", as always. A key that has
# a "_" of its own also gets its checksum, so a_b/c and a/b_c no longer meet in one file (one
# answer was lost when they did).
cache_name() {
  local n; n="$(printf '%s' "$1" | tr '/@' '__')"
  case "$1" in *_*) n="$n-$(printf '%s' "$1" | cksum | cut -d' ' -f1)" ;; esac
  printf '%s' "$n"
}
export -f cache_name

# gh and glab without a time limit could hang status, changed and the launchd guard for ever
# (a dead network, a login prompt). Each call ends after DEPLOYS_TIMEOUT seconds (default 120;
# 0 = none): perl's alarm survives the exec, so the CLI itself gets the signal. Without perl,
# as before. Only defined where the CLI is installed, so `command -v gh` still means "installed".
with_timeout() {  # with_timeout <seconds> <command...>
  local s="$1"; shift
  case "$s" in ''|*[!0-9]*) s=0 ;; esac
  if [ "$s" -gt 0 ] && command -v perl >/dev/null 2>&1; then perl -e 'alarm shift @ARGV; exec { $ARGV[0] } @ARGV or exit 127' "$s" "$@"
  else command "$@"; fi
}
export -f with_timeout
# Exported for the xargs workers; a wrapper inherited where the CLI is missing is dropped.
for _c in gh glab; do
  if type -P "$_c" >/dev/null 2>&1; then
    eval "$_c() { if type -P $_c >/dev/null 2>&1; then with_timeout \"\${DEPLOYS_TIMEOUT:-120}\" $_c \"\$@\"; else command $_c \"\$@\"; fi; }"
    export -f "${_c?}"
  else unset -f "$_c" 2>/dev/null || true; fi
done
days_ago() { date -u -v-"$1"d +%Y-%m-%d 2>/dev/null || date -u -d "$1 days ago" +%Y-%m-%d; }
b64d() { base64 -D 2>/dev/null || base64 -d; }

die() { echo "${ERED:-}Error:${EPLAIN:-} $*" >&2; exit 1; }
# The files a glob names, or nothing when it names none: a bare `cat dir/*.json` fails then, and
# under pipefail that ended a whole `vercel json` that simply had nothing to compare.
cat_all() { cat "$@" 2>/dev/null || true; }
# Tab-separated lines as a table. `column` is optional (not in every Linux image): without it an
# awk padding does the same, so a table never ends a command with 127 and no output.
table() {
  if command -v column >/dev/null 2>&1; then column -t -s $'\t'; return; fi
  awk -F'\t' '{ n[NR] = NF; for (i = 1; i <= NF; i++) { c[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) } }
    END { for (r = 1; r <= NR; r++) { l = ""; for (i = 1; i <= n[r]; i++) l = l (i < n[r] ? sprintf("%-" w[i] "s  ", c[r, i]) : c[r, i]); print l } }'
}

# Colour only for a person at a terminal, never in what the app or a pipe reads.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then RED=$'\033[31m'; GREEN=$'\033[32m'; BOLD=$'\033[1m'; PLAIN=$'\033[0m'
else RED=""; GREEN=""; BOLD=""; PLAIN=""; fi
# The same for messages on stderr, which may go to a terminal while stdout goes to a file (or back).
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then ERED=$'\033[31m'; EPLAIN=$'\033[0m'; else ERED=""; EPLAIN=""; fi
# shellcheck disable=SC2034  # kept for messages that want them
: "$GREEN$BOLD"

# ---------- Team mode: observers, the shared config, approvals ----------

# Observer mode, from the environment or a file. Prints where it comes from, or nothing.
# Plain bash, no jq and no network: doctor and the write guard below must work without either.
readonly_from() {
  # Any value but an explicit no turns it on: a typo ("enabled", "y") must not switch it off silently.
  case "$(printf '%s' "${DEPLOYS_READONLY:-}" | tr '[:upper:]' '[:lower:]')" in
    ""|0|false|no|off) ;;
    *) echo "DEPLOYS_READONLY is set"; return ;;
  esac
  if [ -e "$CONFIG_DIR/readonly" ]; then echo "$CONFIG_DIR/readonly exists"; fi
}

# Where this script really is: symlinks followed (a ~/bin/deploys link keeps working). The one
# place that works it out; providers/ and lib/ are found from here.
script_dir() {
  local f="$1" d
  while [ -L "$f" ]; do d="$(cd -P "$(dirname "$f")" && pwd)"; f="$(readlink "$f")"; case "$f" in /*) ;; *) f="$d/$f";; esac; done
  cd -P "$(dirname "$f")" && pwd
}
# This script as it was called (a symlink stays a symlink), for the commands that run it again and
# for launchd jobs. Not $0: that is the caller's name when the file is sourced (tests, bash -c).
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
# lib/ (team.sh, githost.sh, savings.sh) next to the script, as in a checkout and the app. Without
# one there, the lib/ under a DEPLOYS_DIR from the environment (the Docker image keeps the files
# apart). A copy of the script without either still deploys, and says so where it matters.
LIB_DIR="$(script_dir "${BASH_SOURCE[0]}")/lib"
if [ ! -d "$LIB_DIR" ] && [ -n "${DEPLOYS_DIR:-}" ] && [[ "$(declare -p DEPLOYS_DIR 2>/dev/null)" == "declare -x"* ]]; then
  LIB_DIR="$DEPLOYS_DIR/lib"
fi
# The shared config, observers by list and the two-person rule live in lib/team.sh.
TEAM_LIB="${DEPLOYS_TEAM_LIB:-$LIB_DIR/team.sh}"
# shellcheck source=lib/team.sh
if [ -f "$TEAM_LIB" ]; then . "$TEAM_LIB"; fi
team_on() { declare -F team_gate >/dev/null; }
# deploys hooks install|uninstall|status: the pre-push check in a repo (lib/hooks.sh).
# shellcheck source=lib/hooks.sh
if [ -f "$LIB_DIR/hooks.sh" ]; then . "$LIB_DIR/hooks.sh"; fi
# One HTTP call with retries and hints, shared by the providers (lib/http.sh, PRV-130).
# shellcheck source=lib/http.sh
if [ -f "$LIB_DIR/http.sh" ]; then . "$LIB_DIR/http.sh"; fi
# rules.json ("when … then …" for the daily deploy): lib/rules.sh. Without it no rule counts.
# shellcheck source=lib/rules.sh
# A rules.json without lib/rules.sh to read it stops the run rather than ignore its hold rules.
if [ -f "$LIB_DIR/rules.sh" ]; then . "$LIB_DIR/rules.sh"
else rules_on() { [ ! -f "$CONFIG_DIR/rules.json" ] || die "rules.json is there, but lib/rules.sh is not next to deploys to read it."; return 1; }; fi
# Signs on this Mac that a team file counts here: read without lib/team.sh, from local files only.
team_traces() {
  [ -s "$CONFIG_DIR/team-repos" ] && grep -q '/' "$CONFIG_DIR/team-repos" 2>/dev/null && return 0
  [ -s "$CONFIG_DIR/overrides.json" ] && return 0
  grep -lq '"config":' "$CONFIG_DIR"/team-cache/*.json 2>/dev/null
}

# Every command that changes something on Vercel, Render or GitHub goes through here first.
WRITING=""
require_write() {
  WRITING=1   # lookup then checks remembered ids (CLI-053)
  local why; why="$(readonly_from)"
  if [ -z "$why" ] && team_on; then why="$(team_observer_from)"; fi
  [ -z "$why" ] || die "Observer mode ($why): \"deploys $1\" changes something and is refused. Observers can look, not deploy. To deploy from here: $(if [ -n "${DEPLOYS_READONLY:-}" ]; then echo "unset DEPLOYS_READONLY"; elif [ -e "$CONFIG_DIR/readonly" ]; then echo "deploys readonly off"; else echo "ask to be taken off the observers list"; fi)."
  # Without lib/team.sh the two-person rule and the observers list are not read at all. When this
  # Mac has seen a team file (repos added with `deploys team add`, overrides.json, a cached shared
  # file), going on would skip them without a word: refused instead (an install without lib/).
  if ! team_on && team_traces; then
    die "\"deploys $1\" is refused: this Mac uses a shared deploy-center.json, but $TEAM_LIB is missing, so its approvals and observers would be skipped. Install deploys with its lib/ folder (brew upgrade, or install.sh again)."
  fi
}

# vercel-repos.json as the commands read it: with the projects a shared file maps below it.
repos_json() {
  if team_on; then team_repos_json 2>/dev/null && return; fi
  cat "$REPOS"
}


# ---------- Providers ----------
# One file per platform in providers/ next to this script (docs/PROVIDERS.md). There is no list
# to edit: every providers/<p>.sh is a provider. Symlinks are followed (a ~/bin/deploys link
# keeps working); DEPLOYS_DIR overrides it (the Docker image keeps the files apart).
DEPLOYS_DIR="${DEPLOYS_DIR:-$(script_dir "${BASH_SOURCE[0]}")}"
# A glob, not ls: the folder itself may have spaces in its path.
PROVIDERS=()
for _f in "$DEPLOYS_DIR"/providers/*.sh; do [ -f "$_f" ] || continue; _f="${_f##*/}"; PROVIDERS+=("${_f%.sh}"); done
unset _f
[ "${#PROVIDERS[@]}" -gt 0 ] || die "No providers in $DEPLOYS_DIR/providers. Keep the providers folder next to deploys (or set DEPLOYS_DIR)."
_ok=()
for _p in "${PROVIDERS[@]}"; do
  # A draft must not take every command down with it (doctor included): a file that fails while
  # loading or does not say what it is (<p>_meta) is skipped, and said so. (A syntax error still
  # stops bash itself.)
  # shellcheck source=/dev/null
  . "$DEPLOYS_DIR/providers/$_p.sh" || true
  if declare -F "${_p}_meta" >/dev/null; then _ok+=("$_p")
  else echo "Warning: providers/$_p.sh did not load (or has no ${_p}_meta); left out." >&2; fi
done
# (When none says what it is, the list stays as it was: --version and --help still answer.)
[ "${#_ok[@]}" -eq 0 ] || PROVIDERS=("${_ok[@]}")
unset _p _ok

is_provider() { local p; for p in "${PROVIDERS[@]}"; do [ "$p" = "${1:-}" ] && return 0; done; return 1; }
# --json anywhere asks for the machine answer: `<p> list --json` is `<p> json`,
# `<p> deploy x --json` is `<p> deploy-json x`. The old spellings keep working.
json=0
args=()
# --force "reason" anywhere starts a deploy inside a closed deploy window; the reason goes to the journal.
forced=0; force_reason=""
while [ $# -gt 0 ]; do
  case "$1" in
    # "--" ends the options: what follows is taken as it is (a name from an API, for one).
    --) shift; args+=("$@"); break ;;
    --json) json=1 ;;
    --force) forced=1; force_reason="${2:-}"; [ $# -lt 2 ] || shift ;;
    --force=*) forced=1; force_reason="${1#--force=}" ;;
    *) args+=("$1") ;;
  esac
  shift
done
if [ "$forced" = 1 ] && { [ -z "${force_reason// /}" ] || [ "${force_reason:0:1}" = - ]; }; then
  die '--force needs a reason. Say why with --force: --force "hotfix for the login page"'
fi
if [ "$json" = 1 ]; then
  if is_provider "${args[0]:-}"; then
    case "${args[1]:-}" in
      list) args[1]="json" ;;
      deploy) args[1]="deploy-json" ;;
    esac
  fi
fi
set -- ${args[@]+"${args[@]}"}

# Which providers are switched on. Vercel and Render are on unless turned off; any other provider
# is off until `deploys providers enable <p>` (its meta says defaultOn). The choice is kept in
# providers.json as {"enabled":[...]}; without that file, the defaults. In PROVIDERS order.
PROVIDERS_FILE="$CONFIG_DIR/providers.json"
# A flag anywhere in a provider's meta (defaultOn, or a capability under caps) is true. With jq,
# read as JSON ("defaultOn": true with a space counts); without it (doctor must work), by text.
meta_flag() {
  if command -v jq >/dev/null 2>&1; then
    "${1}_meta" | jq -e --arg k "$2" '[.. | objects | .[$k]? | select(. == true)] | length > 0' >/dev/null 2>&1
  else grep -q "\"$2\": *true" <<<"$("${1}_meta")"; fi
}
enabled_providers() {
  local p on=""
  if [ -s "$PROVIDERS_FILE" ] && on="$(jq -r '.enabled // empty | .[]' "$PROVIDERS_FILE" 2>/dev/null)"; then
    for p in "${PROVIDERS[@]}"; do grep -qxF "$p" <<<"$on" && echo "$p"; done
  else
    # A broken file means the defaults (as without one), but never in silence: a provider that was
    # turned off may be read again.
    [ ! -s "$PROVIDERS_FILE" ] || echo "Warning: $PROVIDERS_FILE cannot be read; the default providers are on until it is fixed (deploys providers enable|disable rewrites it)." >&2
    for p in "${PROVIDERS[@]}"; do meta_flag "$p" defaultOn && echo "$p"; done
  fi
  return 0
}
is_enabled() { grep -qxF "$1" <<<"$(enabled_providers)"; }
# Set up and switched on: the only providers the shared commands touch. A provider that is off
# is never asked anything, not even whether it has a key.
# One whose keychain cannot be read (locked under launchd) counts too: reading it then fails with
# that reason, so `changed` ends in an error instead of a silent "Nothing to deploy".
active_providers() {
  local p
  for p in $(enabled_providers); do
    if ( "${p}_ready" ) >/dev/null 2>&1 || keychain_broken "$p"; then echo "$p"; fi
  done
  return 0
}
provider_on() { is_enabled "$1" && ( "${1}_ready" ) >/dev/null 2>&1; }
# A field of a provider's meta, without jq (doctor runs without it): label, noun.
meta_str() { "${1}_meta" | grep -o "\"$2\":\"[^\"]*\"" | head -n 1 | sed 's/.*:"//; s/"$//'; }

# A provider's key: the variables its meta names in keyEnv, then the keychain entry
# deploy-center-<p>. Prints nothing and fails when there is none. No key is ever printed elsewhere.
key_of() {
  local p="$1" v
  for v in $("${p}_meta" | grep -o '"keyEnv":\[[^]]*\]' | sed 's/"keyEnv"://' | grep -o '[A-Za-z_][A-Za-z0-9_]*'); do
    [ -n "${!v:-}" ] && { printf '%s' "${!v}"; return 0; }
  done
  security find-generic-password -a "$USER" -s "deploy-center-$p" -w 2>/dev/null
}
# Whether the keychain could not be read at all (locked under launchd or SSH, access denied), as
# opposed to "no such item": 0 is found, 44 not found, 127 no `security` (Linux). Anything else
# is an error: such a provider is not "not set up", and must not drop out of the lists silently.
keychain_broken() {  # keychain_broken <p>: true when its key is not in the environment and the keychain fails
  local p="$1" rc=0
  "${p}_meta" | grep -q '"keychain":"' || return 1
  key_of_env "$p" && return 1
  security find-generic-password -a "$USER" -s "deploy-center-$p" -w >/dev/null 2>&1 || rc=$?
  case "$rc" in 0|44|127) return 1 ;; esac
  return 0
}
key_env_names() { "${1}_meta" | grep -o '"keyEnv":\[[^]]*\]' | sed 's/"keyEnv"://' | grep -o '[A-Za-z_][A-Za-z0-9_]*' | paste -sd' ' - | sed 's/ / or /g'; }
key_of_env() {
  local v
  for v in $("${1}_meta" | grep -o '"keyEnv":\[[^]]*\]' | sed 's/"keyEnv"://' | grep -o '[A-Za-z_][A-Za-z0-9_]*'); do
    [ -n "${!v:-}" ] && return 0
  done
  return 1
}

# Which provider a name belongs to, and its id there: "p<TAB>id". "p:name" says it outright.
# Otherwise the names the last list reads saw (names.json), then each active provider is asked.
# A provider's <p>_has: 0 and the id, 1 not there, 2 the platform could not be asked (network,
# login): that is never reported as "no project named".
lookup() {
  local n="$1" p id hits nouns="" rc unasked=""
  case "$n" in
    *:*) p="${n%%:*}"
      if is_provider "$p"; then
        n="${n#*:}"; is_enabled "$p" || die "$(meta_str "$p" label) is off. Turn it on: deploys providers enable $p"
        rc=0; id="$("${p}_has" "$n" 2>/dev/null)" || rc=$?
        [ "$rc" != 2 ] || die "$(meta_str "$p" label) could not be asked about \"$n\" (network or login); try again"
        [ "$rc" = 0 ] && [ -n "$id" ] || die "No $(meta_str "$p" label) $(meta_str "$p" noun) named \"$n\""
        printf '%s\t%s\n' "$p" "$id"; return 0
      fi ;;
  esac
  if [ -s "$CONFIG_DIR/names.json" ]; then
    hits="$(jq -r --arg n "$n" '.[]? | select(.name == $n or .id == $n) | "\(.platform)\t\(.id)"' "$CONFIG_DIR/names.json" 2>/dev/null | sort -u \
      | while IFS=$'\t' read -r p id; do is_enabled "$p" && printf '%s\t%s\n' "$p" "$id"; done)"
    if [ -n "$hits" ]; then
      # Two of them on the same platform: "p:name" would be just as ambiguous, so name the ids.
      if [ "$(cut -f1 <<<"$hits" | sort -u | wc -l | tr -d ' ')" = 1 ] && [ "$(wc -l <<<"$hits" | tr -d ' ')" -gt 1 ]; then
        p="$(head -n 1 <<<"$hits" | cut -f1)"
        die "Several $(meta_str "$p" label) $(meta_str "$p" noun)s are named \"$n\": $(cut -f2 <<<"$hits" | paste -sd, - | sed 's/,/, /g'). Use the id instead, e.g. $(head -n 1 <<<"$hits" | cut -f2)"
      fi
      [ "$(wc -l <<<"$hits" | tr -d ' ')" = 1 ] || die "\"$n\" is on $(cut -f1 <<<"$hits" | sort -u | tr '\n' ' ' | sed 's/ $//; s/ / and /g'). Say which: $(cut -f1 <<<"$hits" | head -n 1):$n"
      # Before a change, the remembered id is checked: a project deleted and made again under the
      # same name has a new one. Gone: every provider is asked below. Not answerable: the old id.
      if [ -z "$WRITING" ]; then echo "$hits"; return 0; fi
      p="${hits%%$'\t'*}"; rc=0; id="$( ( "${p}_has" "$n" ) 2>/dev/null)" || rc=$?
      if [ "$rc" = 0 ] && [ -n "$id" ]; then printf '%s\t%s\n' "$p" "$id"; return 0; fi
      [ "$rc" = 1 ] || { echo "$hits"; return 0; }
    fi
  fi
  # Every active provider is asked: the same name on two of them must not go to whichever came first.
  hits=""
  for p in $(active_providers); do
    rc=0; id="$( ( "${p}_has" "$n" ) 2>/dev/null)" || rc=$?
    if [ "$rc" = 0 ] && [ -n "$id" ]; then hits="$hits$p"$'\t'"$id"$'\n'
    elif [ "$rc" = 2 ]; then unasked="${unasked:+$unasked, }$(meta_str "$p" label)"; fi
  done
  hits="${hits%$'\n'}"
  if [ -n "$hits" ]; then
    [ "$(wc -l <<<"$hits" | tr -d ' ')" = 1 ] || die "\"$n\" is on $(cut -f1 <<<"$hits" | tr '\n' ' ' | sed 's/ $//; s/ / and /g'). Say which: $(cut -f1 <<<"$hits" | head -n 1):$n"
    echo "$hits"; return 0
  fi
  [ -z "$unasked" ] || die "\"$n\" was not found, and $unasked could not be asked (network or login); try again"
  for p in $(enabled_providers); do nouns="${nouns:+$nouns or }$(meta_str "$p" label) $(meta_str "$p" noun)"; done
  die "No ${nouns:-project} named \"$n\""
}
# Only the provider a name is on (verify, risk, ai). Exits with lookup's message when none has it.
platform_of() { local r; r="$(lookup "$1")" || exit $?; echo "${r%%$'\t'*}"; }
# lookup into PLAT, PID and PNAME (the name without a "p:"). Not in a subshell: die ends the command.
resolve() {
  local r; r="$(lookup "$1")" || exit $?
  PLAT="${r%%$'\t'*}"; PID="${r#*$'\t'}"; PNAME="$1"
  case "$PNAME" in "$PLAT":*) PNAME="${PNAME#"$PLAT":}";; esac
}
# A capability a provider does not have: one sentence, the same for every provider.
need_cap() { meta_flag "$1" "$2" || die "$(meta_str "$1" label) cannot $3"; }

# A second start of the same project within a minute of a successful one is refused, across the
# app and the terminal: two quick clicks, or the app and a script at once, would pay for two
# builds. The lock ages out after a minute; a start that failed removes it at once.
start_lock() {
  local d="$CONFIG_DIR/locks" f; mkdir -p "$d"; f="$d/$(echo "$1" | tr '/ ' '__')"
  lock_clear_stale "$f" 60
  # noclobber makes creating the file the check: two starts at the same moment cannot both pass.
  ( set -C; : > "$f" ) 2>/dev/null || die "$1 is being started already (wait a minute)"
  echo "$f"
}

# ---------- GitHub (optional, for "new changes") ----------

# Why a git host did not answer, in words, from what it wrote on stderr (a file): a rate limit,
# no login, no such repo or no access. Shown as "branch head unknown: <why>".
head_why() {  # head_why <stderr file> <host name>
  local e; e="$(grep -v '^[[:space:]]*$' "$1" 2>/dev/null | tail -n 3)"
  case "$e" in
    "") echo "$2 did not answer" ;;
    *"command not found"*|*"No such file"*) echo "the $2 CLI is not installed" ;;
    *[Rr]"ate limit"*|*"secondary rate"*|*"HTTP 429"*) echo "$2's rate limit is reached; try again later" ;;
    *"HTTP 401"*|*"Bad credentials"*|*"auth login"*|*"not logged"*) echo "not logged in to $2 (gh auth login)" ;;
    *"HTTP 404"*|*"Not Found"*) echo "the repo or branch is not on $2, or this login cannot see it" ;;
    *"HTTP 403"*) echo "$2 refused access (HTTP 403)" ;;
    *"HTTP 000"*|*"Could not resolve"*|*"timed out"*|*"connect"*) echo "$2 could not be reached" ;;
    *) echo "$2: $(printf '%s' "$e" | tail -n 1 | cut -c1-150)" ;;
  esac
}
head_of() {
  local repo="$1" ref="$2" out="$3" f ans
  f="$out/$(cache_name "$repo@$ref").json"
  if ans="$(gh api "repos/$repo/commits/$ref" 2>"$f.err")"; then
    echo "$ans" | jq -c --arg k "$repo@$ref" '{key:$k, value:{at:(.commit.committer.date|fromdateiso8601), msg:(.commit.message|split("\n")[0]), sha:.sha}}' \
      > "$f" 2>/dev/null || rm -f "$f"
  else
    # A record of why, so `changed` names the reason instead of guessing "is gh logged in?".
    jq -nc --arg k "$repo@$ref" --arg e "$(head_why "$f.err" GitHub)" '{key:$k, value:{error:$e}}' > "$f" 2>/dev/null || true
  fi
  rm -f "$f.err"
}
export -f head_of head_why

# What is merged but not live: commits from the live commit to the branch, and the pull
# requests among them (squash "(#12)" or "Merge pull request #12"). ahead_by is exact;
# the PR count reads at most the 250 commits GitHub lists.
pending_of() {
  local repo="$1" base="$2" ref="$3" out="$4" key f cmp
  key="$repo@$base@$ref"; f="$out/$(cache_name "$key").json"
  # Cached for five minutes: a reload every quarter hour should not eat GitHub's hourly budget.
  if ! cmp="$(gh api --cache 5m "repos/$repo/compare/$base...$ref" 2>"$f.err")"; then
    # Only a 404 means the live commit is gone from the repo (the branch was rewritten by a
    # force-push, or has no common ancestor with it). This runs only where the branch head was
    # read, so the repo itself is readable. A rate limit or a network error says nothing: no record.
    if grep -qE 'HTTP 404|No common ancestor' "$f.err"; then
      jq -nc --arg k "$key" '{key:$k, value:{rewritten:true}}' > "$f"
    fi
    rm -f "$f.err"; return 0
  fi
  rm -f "$f.err"
  # The risk of the diff comes from the same answer: no extra call.
  echo "$cmp" | jq -c --arg k "$key" "$RISK_DEF"' risk as $risk |
      [.commits[] | {sha, n:(first(.commit.message | (capture("\\(#(?<n>[0-9]+)\\)") // capture("Merge pull request #(?<n>[0-9]+)")) | .n) // null)}] as $c
      | {key:$k, value:{commits:.ahead_by, status:(.status // null), behindBy:(.behind_by // null),
          prs:([$c[] | .n // empty] | unique | length), nums:([$c[] | .n // empty] | unique),
          # GitHub lists 250 commits at most; past that the PR count is a floor.
          partial:(.ahead_by > (.commits | length)),
          oldestAt:(.commits[0].commit.committer.date // null | if . then fromdateiso8601 else null end),
          bare:([$c[] | select(.n == null) | .sha]), risk:$risk}}' > "$f" 2>/dev/null || return 0
  # A rebase merge leaves no number in the message. For a few such commits, ask which PR they came
  # from, four at a time; a PR already named in another message is counted once.
  local bare n
  bare="$(jq -r '.value.bare | if length <= 10 then .[] else empty end' "$f")"
  if [ -n "$bare" ]; then
    n="$(printf '%s\n' $bare | xargs -P 4 -I{} gh api --cache 24h "repos/$repo/commits/{}/pulls" --jq '.[].number' 2>/dev/null \
      | jq -R -s -c 'split("\n") | map(select(length > 0))')" || n='[]'
    jq -c --argjson n "${n:-[]}" '.value.prs = ((.value.nums + $n) | unique | length) | del(.value.bare, .value.nums)' "$f" > "$f.t" && mv "$f.t" "$f"
  else
    jq -c 'del(.value.bare, .value.nums)' "$f" > "$f.t" && mv "$f.t" "$f"
  fi
}
export -f pending_of

# Pull requests still open on the repo: not merged, so not deployable yet either.
# Drafts and bots (Dependabot, Renovate) counted apart, since they rarely mean "ship soon".
open_prs_of() {
  local repo="$1" out="$2"
  # The repo goes to jq as --arg, never into the filter text.
  gh api --cache 5m "repos/$repo/pulls?state=open&per_page=100" 2>/dev/null \
    | jq -c --arg k "$repo" '{key:$k, value:{all:length, partial:(length >= 100), drafts:(map(select(.draft)) | length), bots:(map(select(.user.type=="Bot")) | length)}}' \
    > "$out/$(cache_name "$repo").json" 2>/dev/null || true
}
export -f open_prs_of

# ---------- git hosts: GitHub above, GitLab in lib/githost.sh ----------
# githost_of decides per repo; the githost_* dispatchers hand GitHub repos to the functions above.
# The lib sits next to this script (also inside the app). Without it, GitHub works as before.
if [ -f "$LIB_DIR/githost.sh" ]; then
  # shellcheck source=lib/githost.sh
  . "$LIB_DIR/githost.sh"
else
  githost_of() { case "${1:-}" in *:*|*/*/*) echo unknown ;; */*) echo github ;; *) echo unknown ;; esac; }
  githost_available() { command -v gh >/dev/null 2>&1; }
  githost_head_of() { [ "$(githost_of "$1")" != github ] || head_of "$@"; }
  githost_pending_of() { [ "$(githost_of "$1")" != github ] || pending_of "$@"; }
  githost_open_prs_of() { [ "$(githost_of "$1")" != github ] || open_prs_of "$@"; }
  gitlab_logged_in() { return 1; }
  gitlab_user() { :; }
  # shellcheck disable=SC2016,SC2034  # read by providers and lib/savings.sh
  GITHOST_SLUG_JQ='(sub("^https://github.com/";"") | sub("^https?://";"") | sub("\\.git$";"") | sub("/$";""))'
  # shellcheck disable=SC2016,SC2034  # read by providers/vercel.sh
  GITHOST_VERCEL_LINK_JQ='(if .type == "gitlab" then null else "\(.org)/\(.repo)" end)'
  export -f githost_of githost_head_of githost_pending_of githost_open_prs_of
fi

# The default branch of a repo (GitHub or GitLab); empty when the host cannot tell.
default_branch_of() {
  case "$(githost_of "$1")" in
    github) gh api --cache 1h "repos/$1" --jq '.default_branch // empty' 2>/dev/null | head -n 1 || true ;;
    gitlab) if declare -F gitlab_default_branch >/dev/null; then gitlab_default_branch "$1"; fi ;;
  esac
}

# The one rule for "has changes to deploy", read by `changed`, `deploy-changed` and the app.
# Not deployable, paused, already building, or with no known head: not changed. It reads only the
# shared phase (queued, building, ready, failed, canceled), never a platform's own state names.
CHANGED_RULE='map(. + {building: (.phase == "queued" or .phase == "building")})
  | map(. + {changed: (
  (.deployable // false) and ((.paused // false) | not) and (.headSha != null or .headAt != null)
  and (.building | not) and (.fetchError == null)
  # The branch is behind what is live (live came from newer commits): deploying it would go back.
  and (.compareStatus != "behind")
  and (if .lastSha and .headSha then .lastSha != .headSha else (.headAt // 0) > (.lastAt // 0) end))})'


# Projects without a git repo to compare with: a service built from an image, or a repo on a host
# deploys cannot read (Bitbucket). noRepo says why; null for every other project. Such a project
# has no branch head, so it is never "changed", and it is not "state unknown" either (UNKNOWN_RULE).
with_norepo() {
  local bad="[]" r
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    [ "$(githost_of "$r")" != unknown ] || bad="$(jq -c --arg r "$r" '. + [$r]' <<<"$bad")"
  done < <(echo "$1" | jq -r '.[] | .repo // empty' | sort -u)
  echo "$1" | jq --argjson bad "$bad" 'map(. + {noRepo:(
      if (.repo // null) == null then "no git repo"
      elif (.repo as $r | $bad | index($r)) then "the git host of \(.repo) is not supported"
      elif (.ref // null) == null then "no branch"
      else null end)})'
}

with_heads() {
  local list tmp heads pend opens one
  list="$(with_norepo "$1")" || list="$1"
  # A command about one project (explain, diff, notes, risk, ai) asks GitHub about that one only:
  # DEPLOYS_ONLY (its name) and DEPLOYS_ONLY_ID. No match keeps the whole list, as before.
  if [ -n "${DEPLOYS_ONLY:-}" ]; then
    one="$(echo "$list" | jq -c --arg n "$DEPLOYS_ONLY" --arg i "${DEPLOYS_ONLY_ID:-}" \
      'map(select(.name == $n or .id == $n or ($i != "" and .id == $i)))' 2>/dev/null)" || one=""
    [ -z "$one" ] || [ "$one" = "[]" ] || list="$one"
  fi
  # Without gh (or glab / GITLAB_TOKEN), or when asked to leave the git hosts out (status --watch),
  # no heads: nothing counts as changed.
  if [ -n "${DEPLOYS_NO_GITHUB:-}" ] || ! githost_available; then echo "$list" | jq "$CHANGED_RULE"; return; fi
  tmp="$(mktemp -d)"; mkdir "$tmp/h" "$tmp/p" "$tmp/o"
  echo "$list" | jq -r '.[] | select(.repo and .ref) | "\(.repo) \(.ref)"' | sort -u \
    | xargs -r -P 8 -n 2 bash -c 'githost_head_of "$1" "$2" "$0"' "$tmp/h"
  heads="$(cat_all "$tmp/h"/*.json | jq -s 'from_entries')"
  # An empty answer becomes {} on its own line: bash 3.2 keeps the backslash of an escaped {} default (invalid JSON).
  [ -n "$heads" ] || heads='{}'
  list="$(echo "$list" | jq --argjson h "$heads" 'map(. + (($h["\(.repo)@\(.ref)"] // {}) | {headAt:.at, headMsg:.msg, headSha:.sha, headError:(.error // null)}))')"
  # With GitHub's budget nearly spent, keep it for what decides "changed" (the heads above).
  local left; left="$(github_budget | jq -r '.remaining // 5000' 2>/dev/null || echo 5000)"
  if [ "${left:-5000}" -lt 300 ]; then
    echo "Note: GitHub's hourly budget is nearly spent ($left left): waiting commits, PRs and open PRs are not counted this time." >&2
    rm -rf "$tmp"; echo "$list" | jq "$CHANGED_RULE"' | map(. + {budgetLow:true})'; return
  fi
  # Compared only where the branch moved past the live commit.
  echo "$list" | jq -r '.[] | select(.repo and .ref and .lastSha and .headSha and .lastSha != .headSha) | "\(.repo) \(.lastSha) \(.ref)"' \
    | sort -u | xargs -r -P 8 -n 3 bash -c 'githost_pending_of "$1" "$2" "$3" "$0"' "$tmp/p"
  echo "$list" | jq -r '.[] | .repo // empty' | sort -u | xargs -r -P 8 -n 1 bash -c 'githost_open_prs_of "$1" "$0"' "$tmp/o"
  pend="$(cat_all "$tmp/p"/*.json | jq -s 'from_entries')"
  opens="$(cat_all "$tmp/o"/*.json | jq -s 'from_entries')"
  rm -rf "$tmp"
  [ -n "$pend" ] || pend='{}'; [ -n "$opens" ] || opens='{}'
  echo "$list" | jq --argjson p "$pend" --argjson o "$opens" 'map(
      (if .lastSha and .headSha and .lastSha == .headSha then {commits:0, prs:0} else ($p["\(.repo)@\(.lastSha)@\(.ref)"] // {}) end) as $x
      | ($o[.repo // ""] // {}) as $op
      | . + {pendingCommits:($x.commits // null), pendingPRs:($x.prs // null), pendingPartial:($x.partial // false),
             oldestPendingAt:($x.oldestAt // null), rewritten:($x.rewritten // false),
             # ahead, behind, diverged or identical: how the branch stands to what is live. Null when not compared.
             compareStatus:($x.status // null), behindBy:($x.behindBy // null),
             # green, yellow or red, and why (see RISK_DEF). Null when nothing was compared.
             risk:($x.risk // null),
             # 100 is one page: past that openPRs is a floor (as pendingPartial is for commits).
             openPRs:($op.all // null), openPartial:($op.partial // false), openDrafts:($op.drafts // null), openBots:($op.bots // null)})' \
    | jq "$CHANGED_RULE"
}


# Names for tab completion and lookups, kept up to date by every list read: `names` (one per
# line, read by the completion scripts already in people's shell profiles, and by `ignore`) and
# names.json ([{name, platform, id}], read by lookup).
remember_names() {  # remember_names <p>, the list on stdin
  # In names.json this provider's entries are replaced by the fresh list, so a deleted project
  # goes with the next read; `names` is made from names.json (it used to keep every name for ever).
  # Two providers' lists are read at the same time: each writes its own temp file, and a lost
  # race only costs a name until the next read, never the list itself.
  local p="$1" list t; list="$(cat)"
  t="$(mktemp "$CONFIG_DIR/names.XXXXXX" 2>/dev/null)" || return 0

  { cat "$CONFIG_DIR/names.json" 2>/dev/null || echo '[]'; } \
    | jq -c --arg p "$p" --argjson l "$(echo "$list" | jq -c 'if type == "array" then . else [] end' 2>/dev/null || echo '[]')" \
        '(if type == "array" then . else [] end) | map(select(.platform != $p)) + ($l | map({name, platform:$p, id:(.id // .name)}))' \
        > "$t" 2>/dev/null && mv -f "$t" "$CONFIG_DIR/names.json" 2>/dev/null; rm -f "$t"
  t="$(mktemp "$CONFIG_DIR/names.XXXXXX" 2>/dev/null)" || return 0
  # Only plain names: the completion scripts read this file, and a name like $(cmd) from a
  # platform list must never reach a shell.
  jq -r '.[]? | .name' "$CONFIG_DIR/names.json" 2>/dev/null | { grep -E '^[[:alnum:]._:@ +,=-]+$' || true; } | sort -u > "$t" 2>/dev/null \
    && mv -f "$t" "$CONFIG_DIR/names" 2>/dev/null; rm -f "$t" "$CONFIG_DIR/names.tmp" "$CONFIG_DIR/names.new"
  return 0
}

# `deploys <p> json`: the provider's list, with the branch heads and the rule above.
provider_json() {
  local p="$1" list; list="$("${p}_json")" || exit 1
  echo "$list" | remember_names "$p"
  with_heads "$list"
}

# Every project on every active provider, each marked with its platform. All read at once.
# A provider that is set up here but cannot be read is named on stderr and makes this return 1:
# an empty list must never stand for "all up to date".
all_json() {
  local t rc=0 p; t="$(mktemp -d)"
  for p in $(active_providers); do
    # Its key sits in a keychain that cannot be read (locked under launchd or SSH): say that, not
    # the provider's own "no token" (Render says it itself).
    if [ "$p" != render ] && ! ( "${p}_ready" ) >/dev/null 2>&1 && keychain_broken "$p"; then
      echo "Error: $(meta_str "$p" label): the keychain could not be read (locked? run it in a logged-in session, or set $(key_env_names "$p"))" > "$t/$p.err"
      : > "$t/$p.failed"; continue
    fi
    ( "$SELF" "$p" json 2>"$t/$p.err" | jq --arg p "$p" 'map(. + {platform:$p})' > "$t/$p.json" || : > "$t/$p.failed" ) &
  done
  wait
  for p in "${PROVIDERS[@]}"; do
    [ -f "$t/$p.failed" ] || continue
    rc=1; rm -f "$t/$p.json"
    echo "Error: could not read $p: $(grep -v '^[[:space:]]*$' "$t/$p.err" | tail -n 1 | sed 's/^Error: //' | cut -c1-300)" >&2
  done
  cat_all "$t"/*.json | jq -s 'add // []'
  rm -rf "$t"
  return "$rc"
}

# Deployable projects whose state could not be read: their live deploy (fetchError) or the
# branch head on GitHub is unknown. They are never counted as changed, and never as up to date.
UNKNOWN_RULE='map(select((.deployable // false) and ((.paused // false) | not) and (.noRepo == null)
  and (.fetchError != null or (.headSha == null and .headAt == null))))'

# Every project with changes, both platforms. Projects of unknown state are named on stderr and
# make this return 1, so "nothing to deploy" is only said when everything was read.
changed_json() {
  local all rc=0 unknown
  # No platform on and set up: nothing was read, so nothing is known to be up to date.
  [ -n "$(active_providers)" ] || die "No platform is on and set up, so nothing was read. See: deploys providers"
  all="$(all_json)" || rc=1
  local ign="$CONFIG_DIR/ignored.json" ignl=""; [ -f "$ign" ] || echo '[]' > "$ign"
  # With team mode: what the shared files leave out too, unless this Mac counts it again.
  if team_on; then ignl="$(team_ignored 2>/dev/null)" || ignl=""; fi
  [ -n "$ignl" ] || ignl="$(jq -c . "$ign" 2>/dev/null || echo '[]')"
  all="$(echo "$all" | jq --argjson ign "$ignl" 'map(select(((.name as $n | $ign | index($n)) or ("\(.platform):\(.name)" as $q | $ign | index($q))) | not))')"
  unknown="$(echo "$all" | jq -r "$UNKNOWN_RULE"' | .[] | "\(.platform) \(.name): \(.fetchError // (if .headError then "branch head unknown: \(.headError)" elif ((.repo // "") | split("/") | length) > 2 then "branch head unknown (is glab installed and logged in, or GITLAB_TOKEN set?)" else "branch head unknown (is gh installed and logged in?)" end))"')"
  if [ -n "$unknown" ]; then
    rc=1; echo "Error: state unknown, left out:" >&2; echo "$unknown" | sed 's/^/  /' >&2
  fi
  echo "$all" | jq 'map(select(.changed))'
  return "$rc"
}

# What is left of GitHub's hourly budget for the gh login, as {remaining, limit, reset}.
github_budget() { gh api rate_limit --jq '.resources.core | {remaining, limit, reset}' 2>/dev/null || echo 'null'; }

# ---------- Safe deploys: green CI, deploy window, risk, journal (docs/SAFE-DEPLOY.md) ----------

# "30m", "90s", "1h" or plain seconds, as seconds. Anything else is refused.
duration_s() {
  [[ "${1:-}" =~ ^([0-9]+)([smh]?)$ ]] || return 1
  case "${BASH_REMATCH[2]}" in h) echo $(( BASH_REMATCH[1] * 3600 ));; m) echo $(( BASH_REMATCH[1] * 60 ));; *) echo "${BASH_REMATCH[1]}";; esac
}

# One answer of <p>_status or <p>_latest as "id<TAB>phase<TAB>state" (docs/PROVIDERS.md), or
# nothing when it cannot be read. The contract line is taken as it is; a provider that answers
# with JSON ({id, phase, state|status}, or null for "no deploy") is read too. Only a known phase
# counts: an answer without one must not keep `watch` waiting for ever.
watch_line() {
  local s="$1" id ph st
  case "$s" in
    "") return 0 ;;
    "{"*|"null"|[[:space:]]*)
      s="$(printf '%s' "$s" | jq -r 'if . == null then "none\t\tnone"
        else "\(.id // .deployId // "")\t\(.phase // "")\t\(.state // .status // .phase // "")" end' 2>/dev/null)" || return 0 ;;
  esac
  IFS=$'\t' read -r id ph st <<<"$s"
  [ -n "$id" ] || return 0
  if [ "$id" != none ]; then
    case "$ph" in queued|building|ready|failed|canceled) ;; *) return 0 ;; esac
  fi
  printf '%s\t%s\t%s\n' "$id" "$ph" "${st:-$ph}"
}

# The CI verdict of one commit from GitHub's combined status ($s) and its check runs ($r):
# red when anything failed, pending while anything runs, green when all passed, none without checks.
CI_RULE='($s[0] // {}) as $s | ($r[0] // {}) as $r
  | ([($s.statuses // [])[] | {name:.context, state:(if .state == "success" then "ok" elif .state == "pending" then "wait" else "bad" end)}]
     + [($r.check_runs // [])[] | {name, state:(if .status != "completed" then "wait"
         elif ((.conclusion // "") | IN("success", "neutral", "skipped")) then "ok" else "bad" end)}]) as $all
  | ($all | map(select(.state == "bad") | .name) | unique) as $bad
  | ($all | map(select(.state == "wait") | .name) | unique) as $wait
  | def names: .[0:5] | join(", ") + (if length > 5 then " …" else "" end);
  if ($all | length) == 0 then {state:"none", reason:"no checks on this commit"}
  elif ($bad | length) > 0 then {state:"red", reason:"failed: \($bad | names)"}
  elif ($wait | length) > 0 then {state:"pending", reason:"still running: \($wait | names)"}
  else {state:"green", reason:"\($all | length) checks passed"} end
  | . + {checks:($all | length), failed:($bad | length), running:($wait | length)}'

# The branch a repo calls its default (master, develop …), when no branch is given; main when GitHub
# cannot say (or for GitLab, which answers elsewhere).
default_branch() {  # default_branch <owner/repo>
  local b=""
  [ "$(githost_of "$1")" != github ] || b="$(gh api --cache 1h "repos/$1" --jq .default_branch 2>/dev/null | head -n 1)" || b=""
  [[ "$b" =~ ^[A-Za-z0-9._/-]+$ ]] || b=main
  echo "$b"
}

# "final":true on an unknown verdict: asking again will not help (a GitLab repo nobody can read
# here, a git host deploys does not know). The waits stop at once instead of running out.
ci_of() {  # ci_of <owner/repo> <sha or branch>: the verdict as one line of JSON
  case "$(githost_of "$1")" in
    gitlab) if declare -F gitlab_ci_of >/dev/null; then gitlab_ci_of "$1" "$2"
            else echo '{"state":"unknown","final":true,"reason":"CI of GitLab repos needs lib/githost.sh next to deploys"}'; fi
            return 0 ;;
    unknown) jq -nc --arg r "$1" '{state:"unknown", final:true, reason:"the CI of \($r) cannot be read (only GitHub and GitLab)"}'; return 0 ;;
  esac
  local t rc=0; t="$(mktemp -d)"
  gh api "repos/$1/commits/$2/status" > "$t/s" 2>/dev/null || rc=$((rc + 1))
  # Every page: a monorepo matrix can have more than 100 check runs, and a red one on page 2
  # must not read as green. --paginate prints one object per page; they are joined below.
  gh api --paginate "repos/$1/commits/$2/check-runs?per_page=100" > "$t/r" 2>/dev/null || rc=$((rc + 1))
  # Neither answer: GitHub is down or gh is not logged in. That is not "no checks".
  if [ "$rc" = 2 ]; then echo '{"state":"unknown","reason":"GitHub could not be asked (is gh logged in?)"}'
  else
    jq -e . "$t/s" >/dev/null 2>&1 || : > "$t/s"
    jq -sc '{check_runs:[.[] | (.check_runs // [])[]]}' "$t/r" > "$t/r.t" 2>/dev/null && mv "$t/r.t" "$t/r" || : > "$t/r"
    jq -nc --slurpfile s "$t/s" --slurpfile r "$t/r" "$CI_RULE"
  fi
  rm -rf "$t"
}

# Ask again while the checks run: after 10 s, 20 s, 40 s … at most 2 minutes apart, `max` seconds in all.
# The time slept is counted, plus the time the questions took (SECONDS), not the wall clock alone:
# a test with a stand-in `sleep` still ends, and slow answers do not stretch --wait.
ci_wait() {  # ci_wait <owner/repo> <ref> <max seconds>
  local waited=0 delay=10 v s t0
  while :; do
    t0=$SECONDS
    v="$(ci_of "$1" "$2")"; s="$(echo "$v" | jq -r .state)"
    # Slow answers only: a second of rounding is no wait (and keeps the steps 10, 20, 40 s).
    [ $(( SECONDS - t0 )) -lt 5 ] || waited=$(( waited + SECONDS - t0 ))
    case "$s" in pending|unknown) [ "$(echo "$v" | jq -r '.final // false')" != true ] || { echo "$v"; return 0; } ;; *) echo "$v"; return 0;; esac
    if [ "$waited" -ge "$3" ]; then echo "$v" | jq -c --argjson w "$3" '. + {timedOut:true, waited:$w}'; return 0; fi
    [ $((waited + delay)) -le "$3" ] || delay=$(( $3 - waited ))
    echo "$(date +%H:%M:%S)  $1@${2:0:7}: $(echo "$v" | jq -r .reason), next look in ${delay}s" >&2
    sleep "$delay"; waited=$((waited + delay)); delay=$(( delay * 2 > 120 ? 120 : delay * 2 ))
  done
}

# Deploy windows: ~/.config/deploys/window.json, e.g. {"deny":[{"days":["fri"],"from":"15:00"}]}.
# A rule matches on its days (all when left out), its dates ("2026-12-24"), and from–to local time
# (00:00–24:00 when left out; a "from" after "to" runs over midnight, and the hours after midnight
# belong to the day it started: {"days":["fri"],"from":"22:00","to":"06:00"} is Fri 22:00 to Sat 06:00).
# An optional "tz" (e.g. "Europe/Berlin") reads the clock there instead of in this machine's zone.
WINDOW="$CONFIG_DIR/window.json"
WINDOW_RULE='def hm: split(":") | (.[0] | tonumber) * 60 + ((.[1] // "0") | tonumber);
  def says: (.reason // ("\((.days // .dates // ["every day"]) | join(", ")) \(.from // "00:00")–\(.to // "24:00")"));
  def on($d; $dt): ((.days == null) or (.days | map(ascii_downcase | .[0:3]) | index($d)))
    and ((.dates == null) or (.dates | index($dt)));
  ($time | hm) as $t
  | (($date + "T00:00:00Z") | fromdateiso8601 - 86400) as $y
  | ($y | strftime("%Y-%m-%d")) as $pdate | ($y | strftime("%a") | ascii_downcase) as $pday
  | [(.deny // [])[] | select(((.from // "00:00") | hm) as $f | ((.to // "24:00") | hm) as $u
      | if $f <= $u then on($day; $date) and $t >= $f and $t < $u
        else (on($day; $date) and $t >= $f) or (on($pday; $pdate) and $t < $u) end)] as $hit
  | if ($hit | length) > 0 then {denied:true, reason:($hit[0] | says), rule:$hit[0]} else {denied:false} end
  | . + {configured:true, now:"\($day) \($time) \($date)"}'

# Now as the rules read it, local time: "fri 15:30 2026-11-13". DEPLOYS_NOW stands in for tests,
# and only with DEPLOYS_TESTING=1: a stray DEPLOYS_NOW in a shell must not open a closed window.
now_parts() {  # now_parts [<tz>]
  if [ -n "${DEPLOYS_NOW:-}" ] && [ "${DEPLOYS_TESTING:-}" = 1 ]; then echo "$DEPLOYS_NOW"
  elif [ -n "${1:-}" ]; then TZ="$1" LC_ALL=C date '+%a %H:%M %Y-%m-%d' | tr '[:upper:]' '[:lower:]'
  else LC_ALL=C date '+%a %H:%M %Y-%m-%d' | tr '[:upper:]' '[:lower:]'; fi
}

# What in window.json would silently not do what it says: unknown keys ("day", "form"), times
# that are no HH:MM, day names that are none. One line each, for `deploys window`.
WINDOW_LINT='def time_ok: type == "string" and (test("^([01][0-9]|2[0-3]):[0-5][0-9]$") or . == "24:00");
  (if has("deny") then (keys - ["deny", "tz"] | .[] | "unknown key \"\(.)\" at the top (only deny and tz)")
   else "no \"deny\" list: the deploy window reads only deny (the team-mode shape days/from/to belongs in deploy-center.json)" end),
  ((.deny // []) | to_entries[] | .key as $i | .value
   | ((keys - ["days", "dates", "from", "to", "reason"])[] | "rule \($i + 1): unknown key \"\(.)\""),
     (.from, .to | select(. != null and (time_ok | not)) | "rule \($i + 1): \"\(.)\" is no time (HH:MM)"),
     ((.days // [])[] | select((ascii_downcase | .[0:3]) as $d | ["mon","tue","wed","thu","fri","sat","sun"] | index($d) | not)
      | "rule \($i + 1): \"\(.)\" is no day"),
     ((.dates // [])[] | select(test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") | not) | "rule \($i + 1): \"\(.)\" is no date (YYYY-MM-DD)"))'

window_json() {
  [ -f "$WINDOW" ] || { echo '{"denied":false,"configured":false}'; return 0; }
  local n tz; tz="$(jq -r '.tz // empty' "$WINDOW" 2>/dev/null || true)"
  [[ -z "$tz" || "$tz" =~ ^[A-Za-z0-9_+/-]+$ ]] || die "$WINDOW: \"tz\" must be a time zone like Europe/Berlin"
  n="$(now_parts "$tz")"
  jq -c --arg day "${n%% *}" --arg time "$(echo "$n" | cut -d' ' -f2)" --arg date "${n##* }" "$WINDOW_RULE" "$WINDOW" 2>/dev/null \
    || die "$WINDOW could not be read (see docs/SAFE-DEPLOY.md for the format)"
}

# Inside a denied window a start is refused, unless --force "reason" was given. Asked once per
# run: what this run starts itself (render deploy -> deploy-json) is not asked again.
# Sets `frozen` to the window's text when the run goes ahead inside one.
# A shell variable, not the environment: nothing set from outside can skip the check.
frozen=""; window_checked=""
# The shared window of deploy-center.json (docs/TEAM.md) is the other way round: when deploys
# are allowed, {"days":["mon",…], "from":"09:00", "to":"16:00", "tz":"Europe/Berlin"} (or a
# list of them: any one open is enough). Outside it is closed. A window.json-style {"deny":…}
# that reaches a project through overrides is the local window, checked by window_json.
TEAM_WINDOW_RULE='def hm: split(":") | (.[0] | tonumber) * 60 + ((.[1] // "0") | tonumber);
  def open1: ((.days == null) or (.days | map(ascii_downcase | .[0:3]) | index($day)))
      and ((.dates == null) or (.dates | index($date)))
      and (((.from // "00:00") | hm) as $f | ((.to // "24:00") | hm) as $u | ($time | hm) as $t
           | if $f <= $u then $t >= $f and $t < $u else $t >= $f or $t < $u end);
  def says: "\((.days // ["every day"]) | join(", ")) \(.from // "00:00")–\(.to // "24:00")\(if .tz then " " + .tz else "" end)";
  (if type == "array" then . else [.] end) as $w
  | if any($w[]; open1) then {denied:false} else {denied:true, reason:"outside the shared deploy window (\($w | map(says) | join("; ")))"} end'
TEAM_EFF_CACHE=""
team_eff_once() { if [ -z "$TEAM_EFF_CACHE" ]; then TEAM_EFF_CACHE="$(team_effective 2>/dev/null)" || TEAM_EFF_CACHE='{}'; fi; echo "$TEAM_EFF_CACHE"; }
# team_window_denied <name>: why the shared window of that project is closed now, or nothing.
team_window_denied() {
  team_on || return 0
  local n="${1#*:}" w tz now
  is_provider "${1%%:*}" || n="$1"
  w="$(team_eff_once | jq -c --arg n "$n" '.projects[$n].window.value // null | if type == "object" and has("deny") then null else . end' 2>/dev/null)"
  [ -n "$w" ] && [ "$w" != null ] || return 0
  tz="$(echo "$w" | jq -r 'if type == "array" then .[0].tz else .tz end // empty')"
  # DEPLOYS_NOW counts only with DEPLOYS_TESTING=1, as in now_parts.
  local testnow=""; [ -z "${DEPLOYS_NOW:-}" ] || [ "${DEPLOYS_TESTING:-}" != 1 ] || testnow=1
  # An unknown zone would silently read as UTC: refused instead.
  if [ -n "$tz" ] && [ -z "$testnow" ] && [ ! -f "/usr/share/zoneinfo/$tz" ]; then
    echo "the shared deploy window of $n names an unknown time zone \"$tz\""; return 0
  fi
  # Now in the window's own zone (DEPLOYS_NOW stands in for tests, as in now_parts).
  if [ -n "$testnow" ] || [ -z "$tz" ]; then now="$(now_parts)"
  else now="$(TZ="$tz" LC_ALL=C date '+%a %H:%M %Y-%m-%d' | tr '[:upper:]' '[:lower:]')"; fi
  echo "$w" | jq -r --arg day "${now%% *}" --arg time "$(echo "$now" | cut -d' ' -f2)" --arg date "${now##* }" \
    "$TEAM_WINDOW_RULE"' | if .denied then .reason else empty end' 2>/dev/null || echo "the shared deploy window of $n could not be read"
}
# freeze_check [<name>...]: the local window, then the shared window of each project named.
freeze_check() {
  [ -z "$window_checked" ] || return 0
  local w n why
  # Read once here, in this shell: team_window_denied runs in $(…), where a cache would be lost.
  if team_on; then team_eff_once >/dev/null; fi
  w="$(window_json)" || exit 1
  if [ "$(echo "$w" | jq -r .denied)" = true ]; then
    frozen="$(echo "$w" | jq -r .reason)"
    [ "$forced" = 1 ] || die "No deploys now: the deploy window says \"$frozen\". To deploy anyway: --force \"why\""
  fi
  for n in "$@"; do
    [ -n "$n" ] || continue
    why="$(team_window_denied "$n")"
    [ -n "$why" ] || continue
    [ "$forced" = 1 ] || die "No deploys of $n now: $why. To deploy anyway: --force \"why\""
    frozen="${frozen:+$frozen; }$n: $why"
  done
  window_checked=1
}
# A start inside a window, and why, goes to the journal the app shows.
# The app writes its own entry for what it starts (DEPLOYS_CALLER=app): one line, not two.
journal_forced() {  # journal_forced <platform> <name>
  [ -n "$frozen" ] || return 0
  [ "${DEPLOYS_CALLER:-}" != app ] || return 0
  journal_add "$1" "$2" forced "Deployed in the window \"$frozen\": $force_reason"
}

# The app's journal (Deploy history), so what the terminal did shows there too.
journal_file() {
  if [ -n "${DEPLOYS_JOURNAL:-}" ]; then echo "$DEPLOYS_JOURNAL"
  elif [ "$(uname)" = Darwin ]; then echo "$HOME/Library/Application Support/app.deploycenter.mac/journal.jsonl"
  else echo "$CONFIG_DIR/journal.jsonl"; fi
}
journal_add() {  # journal_add <platform> <name> <result> <detail>
  local f p; f="$(journal_file)"
  # The provider's own label (Netlify, Cloudflare Pages …), as the app writes it.
  p=""; if is_provider "$1"; then p="$(meta_str "$1" label 2>/dev/null)"; fi; [ -n "$p" ] || p="$1"
  mkdir -p "$(dirname "$f")" 2>/dev/null || return 0
  # The app shortens the file now and then: both take "<file>.lock" (a folder) for that moment.
  # Waited for two seconds at most; a line is never lost to a stale lock.
  local locked=""; file_lock "$f" 0 && locked=1
  # FEA-041: prevHash is the SHA-256 of the line before (as written), so a changed or removed
  # line shows; null for the first line or without shasum/sha256sum.
  local prev=""
  if [ -s "$f" ]; then
    prev="$(tail -n 1 "$f" | { sha256sum 2>/dev/null || shasum -a 256 2>/dev/null; } | cut -d' ' -f1)" || prev=""
  fi
  jq -nc --arg p "$p" --arg n "$2" --arg r "$3" --arg d "$4" --arg h "$prev" \
    '{at:(now | floor | todate), platform:$p, name:$n, result:$r, seconds:null, detail:$d, prevHash:(if $h == "" then null else $h end)}' >> "$f" 2>/dev/null || true
  [ -z "$locked" ] || file_unlock "$f"
}

# What a pending diff touches, from a GitHub comparison (its .files): migrations are red, lockfiles,
# environment files and config yellow, a large diff yellow and a very large one red. The worst wins.
# Each reason has a kind, so the app can say it in its own language.
# shellcheck disable=SC2089,SC2090  # a jq program, handed to jq as one argument
RISK_DEF='def risk:
  [(.files // [])[] | .filename] as $f
  | def hits(re): [$f[] | select(test(re))];
    def some(fs): fs[0:3] | join(", ") + (if (fs | length) > 3 then " and \((fs | length) - 3) more" else "" end);
  hits("(^|/)(migrations?|migrate|prisma)/|\\.sql$|(^|/)schema\\.(prisma|rb)$") as $mig
  | hits("(^|/)(package-lock\\.json|npm-shrinkwrap\\.json|pnpm-lock\\.yaml|yarn\\.lock|bun\\.lockb?|Pipfile\\.lock|poetry\\.lock|uv\\.lock|Gemfile\\.lock|Cargo\\.lock|go\\.sum|composer\\.lock)$") as $lock
  | hits("(^|/)\\.env($|\\.)") as $env
  | hits("(^|/)(vercel\\.json|render\\.yaml|Dockerfile|docker-compose\\.ya?ml|Procfile|(next|vite|nuxt|astro|svelte|remix)\\.config\\.[a-z]+)$|^\\.github/workflows/") as $cfg
  | ([(.files // [])[] | (.additions // 0) + (.deletions // 0)] | add // 0) as $lines
  | ($f | length) as $n
  | [ (if ($mig | length) > 0 then {kind:"migrations", level:"red", files:$mig[0:10], text:"database migrations: \(some($mig))"} else empty end),
      (if ($lock | length) > 0 then {kind:"lockfile", level:"yellow", files:$lock[0:10], text:"dependencies changed: \(some($lock))"} else empty end),
      (if ($env | length) > 0 then {kind:"env", level:"yellow", files:$env[0:10], text:"environment files: \(some($env))"} else empty end),
      (if ($cfg | length) > 0 then {kind:"config", level:"yellow", files:$cfg[0:10], text:"build or platform config: \(some($cfg))"} else empty end),
      (if $lines > 3000 or $n >= 100 then {kind:"size", level:"red", files:[], text:"a very large diff: \($n) files, \($lines) lines"}
       elif $lines > 500 or $n > 30 then {kind:"size", level:"yellow", files:[], text:"a large diff: \($n) files, \($lines) lines"} else empty end) ] as $r
  | {level:(if any($r[]; .level == "red") then "red" elif ($r | length) > 0 then "yellow" else "green" end),
     reasons:$r, files:$n, lines:$lines};'
# shellcheck disable=SC2090
export RISK_DEF

# The site of a project: its own domain first, then the platform address.
site_url_of() {  # site_url_of <project> <platform>
  if [ "$2" = vercel ]; then
    vercel_call "/v9/projects/$1" | jq -r '((.targets.production.alias // []) | map(select(endswith(".vercel.app")|not)) | .[0]) // (.targets.production.alias[0] // empty) | "https://\(.)"'
  elif [ "$2" = render ]; then
    render_call GET "/services/$(render_id_of "$1")" | jq -r '.serviceDetails.url // empty'
  else ( "${2}_url" "$1" ) 2>/dev/null || true; fi
}

# One start, through the same functions (and the same start lock) as the app.
deploy_one() {  # deploy_one <platform> <name> [<sha>] [<id>]: the start as JSON
  # By its id when known (Render: srv-…): a name may hold characters an API path cannot (safe_arg refuses them).
  local id="${4:--}"; [ "$id" != "-" ] || id="$2"
  ( "${1}_deploy_json" "$id" ${3:+--sha "$3"} )
}

# Savings estimates and the plan, kept in lib/savings.sh and lib/plan.sh next to this script (or
# in the app's Resources). Loaded only by the commands that put a price on builds.
load_savings() {
  [ -z "${SAVINGS_LOADED:-}" ] || return 0
  local lib="${DEPLOYS_SAVINGS_LIB:-$LIB_DIR/savings.sh}"
  [ -f "$lib" ] || die "lib/savings.sh is missing next to deploys ($lib)"
  # shellcheck source=lib/savings.sh
  . "$lib"
  [ -f "$LIB_DIR/plan.sh" ] || die "lib/plan.sh is missing next to deploys ($LIB_DIR/plan.sh)"
  # shellcheck source=lib/plan.sh
  . "$LIB_DIR/plan.sh"
  SAVINGS_LOADED=1
}

# --when-green as a preview: the same ci_of as the real run (four at a time), so what it promises
# is what --yes does: green starts, red is skipped, pending would be waited for. Adds ci and wouldDo.
with_ci_preview() {  # with_ci_preview <changed list JSON>
  local list="$1" cid i=0 k repo sha cis
  cid="$(mktemp -d)"
  while IFS=$'\t' read -r k repo sha; do
    [ -n "$k" ] || continue
    if [ -z "$repo" ] || [ -z "$sha" ]; then echo '{"state":"unknown","reason":"the commit or repo is unknown, so its checks are too","noRepo":true}' > "$cid/$k"; continue; fi
    ( ci_of "$repo" "$sha" </dev/null > "$cid/$k" 2>/dev/null || true ) &
    i=$((i + 1)); [ $((i % 4)) != 0 ] || wait
  done <<< "$(echo "$list" | jq -r 'to_entries[] | "\(.key)\t\(.value.repo // "")\t\(.value.headSha // "")"')"
  wait
  cis="$(for k in $(echo "$list" | jq -r 'keys[]'); do jq -c . "$cid/$k" 2>/dev/null || echo '{"state":"unknown","reason":"no answer"}'; done | jq -sc .)"
  rm -rf "$cid"
  echo "$list" | jq -c --argjson c "$cis" 'to_entries | map(.value + {ci:$c[.key],
    wouldDo:(if ($c[.key].state == "green" or $c[.key].state == "none") then "would-deploy"
             elif $c[.key].state == "red" or $c[.key].noRepo == true then "would-skip" else "would-wait" end)})'
}
# The rows of the deploy-changed preview (its --json), from the list with or without wouldDo.
PREVIEW_ROWS='[.[] | {platform, name, sha:(.headSha // null), action:(.wouldDo // "would-deploy"), commits:(.pendingCommits // null), risk:(.risk.level // null)}
  + (if .ci then {ci:{state:.ci.state, reason:(.ci.reason // null)}} else {} end)
  + (if .rule then {rule:.rule} else {} end)]'

# rules.json on the list of deploy-changed and plan: a "hold" rule leaves the project out (sets
# `held` to those, as preview rows), and with --by-rules only what a "deploy" rule matched stays.
# Works on the variable `list` itself (a $(…) would lose `held`).
held="[]"
apply_rules() {  # apply_rules <by-rules: 1 or empty>
  local l="$list"
  if rules_on; then
    l="$(with_rules "$l")"
    held="$(echo "$l" | jq -c '[.[] | select(.rule.then == "hold")]' | jq -c "$PREVIEW_ROWS"' | map(.action = "held-by-rule")')"
    l="$(echo "$l" | jq -c '[.[] | select(.rule.then != "hold")]')"
  fi
  [ -z "${1:-}" ] || l="$(echo "$l" | jq -c '[.[] | select(.rule.then == "deploy")]')"
  list="$l"
}

# What looks like a secret in the added lines of a GitHub comparison (.files[].patch), as
# .secrets [{file, line, kind}]: the line number in the new file, never the value. A rough net:
# known key shapes, and NAME=long-value assignments to names like *_SECRET, *_TOKEN, PASSWORD.
SECRETS_JQ='def kinds: [
    {k:"aws-access-key", r:"AKIA[0-9A-Z]{16}"},
    {k:"github-token", r:"gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{40,}"},
    {k:"slack-token", r:"xox[abprs]-[A-Za-z0-9-]{10,}"},
    {k:"stripe-key", r:"[sr]k_live_[A-Za-z0-9]{16,}"},
    {k:"anthropic-key", r:"sk-ant-[A-Za-z0-9_-]{20,}"},
    {k:"openai-key", r:"sk-(proj-)?[A-Za-z0-9]{32,}"},
    {k:"google-api-key", r:"AIza[0-9A-Za-z_-]{35}"},
    {k:"private-key", r:"-----BEGIN [A-Z ]*PRIVATE KEY-----"},
    {k:"assignment", r:"(?i)(secret|token|passw(or)?d|api[_-]?key|private[_-]?key)[A-Za-z0-9_]*[\"'"'"']?[ \t]*[:=][ \t]*[\"'"'"']?[A-Za-z0-9/+_=.-]{16,}"}];
  def scan_patch($file):
    (split("\n") | reduce .[] as $l ({n:0, out:[]};
      if ($l | startswith("@@")) then .n = (($l | capture("\\+(?<s>[0-9]+)").s | tonumber) - 1)
      elif ($l | startswith("+")) then .n += 1
        | . as $st | .out += [kinds[] | . as $k | select($l[1:] | test($k.r)) | {file:$file, line:$st.n, kind:$k.k}]
      elif ($l | startswith("-")) then .
      else .n += 1 end) | .out);
  .secrets = ([(.files // [])[] | select(.patch) | . as $f | .patch | scan_patch($f.filename)[]] | unique_by([.file, .line]) | .[0:50])'

# ---------- Costs (Vercel billing, one UTC day per request) ----------

# One day of charges, summed: total, builds, and builds per project.
cost_day() {
  local from="$1" to="$2" team="$3" out="$4" raw
  # A day that could not be read writes no file: it is missing (costs: missingDays), not $0.
  raw="$(vercel api "/v1/billing/charges?from=${from}T00:00:00.000Z&to=${to}T00:00:00.000Z${team:+&teamId=$team}" 2>/dev/null)" || return 0
  printf '%s' "$raw" | jq -sc --arg d "$from" '{day:$d,
        total:(map(.BilledCost) | add // 0),
        build:(map(select(.ServiceCategory=="Build & Deploy" or (.ServiceName|test("Build")))) | map(.BilledCost) | add // 0),
        projects:(map(select(.ServiceName|test("Build"))) | group_by(.Tags.ProjectName // "?")
          | map({name:(.[0].Tags.ProjectName // "?"), build:(map(.BilledCost)|add)}))}' \
    > "$out/$from.json" 2>/dev/null || true
}
export -f cost_day days_ago

# ---------- Other things that start builds ----------

# A workflow that deploys by itself defeats turning auto-deploy off. The deploy commands of every
# platform: Vercel, Render, Netlify, Cloudflare (wrangler), DigitalOcean (doctl), Amplify (aws),
# Coolify (its /deploy API or webhook), and any deploy hook.
WORKFLOW_DEPLOY_RE='vercel (deploy|--prod)|vercel-action|api\.render\.com/deploy|render-deploy|deploy[-_]hook|DEPLOY_HOOK|netlify (deploy|api createSiteDeploy)|netlify-cli|nwtgck/actions-netlify|wrangler (pages )?deploy|wrangler-action|cloudflare/pages-action|doctl apps (create-deployment|update)|digitalocean/app_action|aws amplify start-job|amplify publish|coolify[^ ]*/api/v1/deploy|/api/v1/deploy\?uuid=|COOLIFY_(WEBHOOK|TOKEN)'
export WORKFLOW_DEPLOY_RE
workflow_hits() {
  local repo="$1" out="$2"
  gh api "repos/$repo/contents/.github/workflows" --jq '.[] | select(.type=="file") | .path' 2>/dev/null | while read -r f; do
    gh api "repos/$repo/contents/$f" --jq '.content' 2>/dev/null | b64d 2>/dev/null \
      | grep -vE '^[[:space:]]*#' \
      | grep -qE "$WORKFLOW_DEPLOY_RE" \
      && jq -nc --arg w "$repo" --arg d "$f" '{kind:"workflow", where:$w, detail:$d}'
  done > "$out/$(cache_name "$repo").jsonl" || true
}
export -f workflow_hits b64d

