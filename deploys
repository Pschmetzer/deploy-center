    render_call GET "/services/${3:?service id}/deploys/${4:?deploy id}" | jq '{id, state:.status}' ;;
  "render forget-key")
    # Both names the key was ever stored under. A key in RENDER_API_KEY is not touched.
    gone=0
    for svc in "$KEYCHAIN_SERVICE" "$LEGACY_KEYCHAIN_SERVICE"; do
      security delete-generic-password -a "$USER" -s "$svc" >/dev/null 2>&1 && gone=$((gone + 1))
    done
    if [ "$gone" -gt 0 ]; then echo "Render key removed from the keychain."; else echo "No Render key was in the keychain."; fi
    [ -z "${RENDER_API_KEY:-}" ] || echo "RENDER_API_KEY is still set in the environment." ;;
  "render set-key")
    IFS= read -r key || true
    [ -n "$key" ] || die "Pipe the key in: pbpaste | deploys render set-key"
    case "$key" in *\'*|*\"*|*' '*) die "That does not look like a Render API key";; esac
    # Tried first, saved only when Render takes it: a typo must not replace a working key.
    ( RENDER_API_KEY="$key" render_call GET "/services?limit=1" >/dev/null ) || die "Render did not accept that key; nothing was saved"
    # Sent to `security -i` on stdin, so the key is never an argument anyone can see.
    printf 'add-generic-password -U -a %s -s %s -w %s\n' "$USER" "$KEYCHAIN_SERVICE" "$key" | security -i >/dev/null \
      || die "The key works, but could not be saved in the keychain"
    echo "Render key saved and working." ;;
  "render json")
    list="$(render_services | jq '[.[] | {id, name, type, paused:(.suspended=="suspended"),
      auto:('"$(render_auto)"' != "off"), deployable:(.suspended!="suspended"),
      url:(.serviceDetails.url // null),
      domain:((.serviceDetails.url // "") | sub("^https?://";"") | if . == "" then null else . end),
      repo:((.repo // "") | '"$GITHOST_SLUG_JQ"' | if . == "" then null else . end),
      ref:(.branch // null)}] | sort_by(.name | ascii_downcase)')"
    # Render names too, for tab completion and the `ignore` name check.
    echo "$list" | remember_names
    tmp="$(mktemp -d)"; kf="$tmp/key"; (umask 077; render_key > "$kf")
    echo "$list" | jq -r '.[].id' | xargs -P 8 -n 1 bash -c 'render_last_of "$0" "'"$tmp"'" "'"$kf"'"'
    rm -f "$kf"
    lasts="$(cat_all "$tmp"/*.json | jq -s 'from_entries')"; rm -rf "$tmp"
    list="$(echo "$list" | jq --argjson l "${lasts:-{\}}" 'map(. + ($l[.id] // {}))')"
    with_heads "$list" ;;

  "autodeploy allow")
    # autodeploy allow <vercel|render|all> <project>|--all <hours>
    allow_main "${3:-}" "${4:-}" "${5:-}" ;;
  "autodeploy revoke")
    revoke_main "${3:-}" "${4:-}" ;;
  "autodeploy allowed")
    if [ "$json" = 1 ]; then allow_list
    else
      allow_list | jq -r '.[] | [.platform, .project, (.expiresAt | strftime("%Y-%m-%d %H:%M UTC")), "\(((.expiresAt - now) / 60) | floor) min left"] | @tsv' \
        | (printf 'PLATFORM\tPROJECT\tUNTIL\tLEFT\n'; cat) | column -t -s $'\t'
    fi ;;
  "autodeploy "*)
    die "Usage: deploys autodeploy allow <vercel|render|all> <project>|--all <hours> | allowed [--json] | revoke <vercel|render|all> <project>|--all" ;;

  "guard schedule")
    case "${3:-}" in
      on) guard_schedule_on; echo "The guard runs every 30 minutes (log: ~/Library/Logs/DeployCenter-guard.log). Its first run only reports." ;;
      off) guard_schedule_off; echo "The guard no longer runs by itself." ;;
      *) if guard_scheduled; then echo on; else echo off; fi ;;
    esac ;;
  "guard status")
    en=false; guard_scheduled && en=true
    s="$(guard_state | jq --argjson en "$en" --argjson al "$(allow_list)" \
      '{enabled:$en, lastRun:(.lastRun // null), lastDry:(.lastDry // null), firstRunPending:(.firstRunPending // false),
        lastActions:(.lastActions // []), allowances:$al}')"
    if [ "$json" = 1 ]; then echo "$s"
    else
      echo "$s" | jq -r '"guard        \(if .enabled then "on (every 30 minutes)" else "off" end)",
        "last run     \(if .lastRun then (.lastRun | strftime("%Y-%m-%d %H:%M UTC")) + (if .lastDry then " (dry run)" else "" end) else "never" end)",
        (.lastActions[] | "  \(.action)  \(.platform) \(.project // "")\(if .error then ": " + .error else "" end)"),
        "allowances   \(.allowances | length)",
        (.allowances[] | "  \(.platform) \(.project) until \(.expiresAt | strftime("%Y-%m-%d %H:%M UTC"))")'
    fi ;;
  "guard "*)
    # guard [--dry-run]: auto-deploy off wherever it is on without a running allowance. For launchd.
    dry=""
    for a in "${@:2}"; do case "$a" in --dry-run) dry=1;; *) die "Usage: deploys guard [--dry-run] | status [--json] | schedule on|off";; esac; done
    guard_main "$dry" ;;

  "autofix set-token")
    # The routine's API token (claude.ai: routine > Trigger > API > Generate token), from stdin.
    IFS= read -r key || true
    [ -n "$key" ] || die "Pipe the token in: pbpaste | deploys autofix set-token"
    case "$key" in sk-ant-*) ;; *) die "That does not look like a routine token (sk-ant-...)";; esac
    printf 'add-generic-password -U -a %s -s %s -w %s\n' "$USER" "$AUTOFIX_KEYCHAIN" "$key" | security -i >/dev/null \
      || die "Could not save the token in the keychain"
    echo "Routine token saved." ;;
  "autofix forget-token")
    security delete-generic-password -a "$USER" -s "$AUTOFIX_KEYCHAIN" >/dev/null 2>&1 && echo "Routine token removed." || echo "No routine token was saved." ;;
  "autofix routine")
    if [ -n "${3:-}" ]; then
      case "$3" in trig_*) ;; *) die "A routine id starts with trig_";; esac
      printf '%s' "$3" > "$CONFIG_DIR/autofix-routine"; echo "Autofix routine set to $3"
    else r="$(af_routine)"; echo "${r:-none}"; fi ;;
  "autofix prompt")
    af_prompt ;;
  "autofix schedule")
    case "${3:-}" in
      on) af_schedule_on; echo "Autofix runs every 10 minutes (log: ~/Library/Logs/DeployCenter-autofix.log)." ;;
      off) af_schedule_off; echo "Autofix no longer runs by itself." ;;
      *) if af_scheduled; then echo on; else echo off; fi ;;
    esac ;;
  "autofix status")
    # For the app: what is set up, and the newest hand-overs. Never the token itself.
    tok=false; [ -n "$(af_token)" ] && tok=true
    sch=false; af_scheduled && sch=true
    af_state | jq --arg r "$(af_routine)" --argjson tok "$tok" --argjson sch "$sch" \
      '{routine:(if $r == "" then null else $r end), token:$tok, scheduled:$sch,
        fires:(.fires | sort_by(-.at) | .[0:20] | map({at, project, platform, status, sha:(.sha // null),
          session:(.session // null), error:(.error // .reason // null), redeployedSha:(.redeployedSha // null), mergedSha:(.mergedSha // null), pr:(.pr // .prNumber // null),
          prNumber:(.prNumber // .pr // null), prState:(.prState // (if .mergedSha then "merged" else null end)), prUrl:(.prUrl // null)}))}' ;;
  "autofix list")
    af_state | jq -r '.fires[] | [(.at | strftime("%Y-%m-%d %H:%M")), .project, .status, ((.sha // "")[0:7]), (.session // .error // .reason // ""), (if .mergedSha then "merged \(.mergedSha[0:7]) (PR #\(.pr)), deploy by hand" elif .redeployedSha then "redeployed \(.redeployedSha[0:7]) (PR #\(.pr))" else "" end)] | @tsv' \
      | (printf 'WHEN\tPROJECT\tSTATUS\tCOMMIT\tSESSION\tREDEPLOY\n'; cat) | column -t -s $'\t' ;;
  "autofix "*)
    # autofix [--dry-run]: hand a failed build to the routine, deploy a merged fix. For launchd.
    # autofix --only <platform> <project>: this one failure now (exit codes in docs/AUTOFIX.md).
    dry=""; oplat=""; oname=""; shift
    while [ $# -gt 0 ]; do
      case "$1" in
        --dry-run) dry=1;;
        --only) case "${2:-}" in vercel|render) ;; *) die "Usage: deploys autofix --only <vercel|render> <project>";; esac
                [ -n "${3:-}" ] || die "Usage: deploys autofix --only <vercel|render> <project>"
                oplat="$2"; oname="$3"; shift 2;;
        *) die "Unknown option $1. Usage: deploys autofix [--dry-run] [--only <platform> <project>] | set-token | routine [<id>] | list | status | prompt | schedule on|off";;
      esac; shift
    done
    if [ -z "$dry" ]; then
      nr=1; [ -z "$oname" ] || nr="$AF_NO_ROUTINE"
      [ -n "$(af_routine)" ] || { echo "${RED}Error:${PLAIN} No routine set. See docs/AUTOFIX.md, then: deploys autofix routine <trig_id>" >&2; exit "$nr"; }
      [ -n "$(af_token)" ] || { echo "${RED}Error:${PLAIN} No routine token. Run: pbpaste | deploys autofix set-token" >&2; exit "$nr"; }
    fi
    autofix_run "$dry" "$oplat" "$oname" ;;

  "simulate "*|"ledger "*)
    # Savings estimates, kept in lib/savings.sh next to this script (or in the app's Resources).
    lib="${DEPLOYS_SAVINGS_LIB:-$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)/lib/savings.sh}"
    [ -f "$lib" ] || die "lib/savings.sh is missing next to deploys ($lib)"
    # shellcheck source=lib/savings.sh
    . "$lib"; savings_main "$@" ;;

  *)
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
