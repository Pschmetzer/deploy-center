  "ci "*)
    # ci <owner/repo> [<sha or branch>] [--wait 30m]: green, pending, red or none, and why.
    # Exit 0 green (or no checks), 1 red, 2 still pending or GitHub not reachable; with --json
    # always 0, the verdict is in the answer (the app reads it).
    repo="$2"; ref="main"; maxw=0; shift 2
    case "$repo" in */*) ;; *) die "Give the repo as owner/name";; esac
    while [ $# -gt 0 ]; do
      case "$1" in
        --wait) maxw="$(duration_s "${2:-}")" || die "--wait takes a time like 30m, 90s or 1h"; shift ;;
        -*) die "Unknown option $1. Usage: deploys ci <owner/repo> [<sha or branch>] [--wait 30m] [--json]" ;;
        *) ref="$1" ;;
      esac
      shift
    done
    v="$(ci_wait "$repo" "$ref" "$maxw")"
    if [ "$json" = 1 ]; then echo "$v" | jq --arg r "$repo" --arg ref "$ref" '{repo:$r, ref:$ref} + .'; exit 0; fi
    echo "$v" | jq -r '"\(.state): \(.reason)"'
    case "$(echo "$v" | jq -r .state)" in green|none) exit 0;; red) exit 1;; *) exit 2;; esac ;;

  "window "*)
    # Whether the deploy window is open now (window.json); exit 0 open, 1 closed (--json: always 0).
    w="$(window_json)"
    if [ "$json" = 1 ]; then echo "$w" | jq '. + {file:$f}' --arg f "$WINDOW"; exit 0
    elif [ "$(echo "$w" | jq -r .configured)" != true ]; then echo "No deploy window set ($WINDOW). Deploys are allowed at any time."
    elif [ "$(echo "$w" | jq -r .denied)" = true ]; then echo "${RED}Closed${PLAIN}: $(echo "$w" | jq -r .reason). Deploys need --force \"why\"."
    else echo "${GREEN}Open${PLAIN}: no rule in $WINDOW applies now."; fi
