  "verify "*)
    # verify <project> [--path /health] [--rollback-after 10] [--no-rollback] [--url <address>]
    # Once the newest deploy is ready: ask the site three times, 5 s apart. When every answer is
    # 5xx or none (a timeout), the check failed (as in the app: a fresh service may answer 502 for a
    # moment); then a countdown, and production goes back unless --no-rollback or Ctrl-C.
    # Exit 0 healthy, 1 failed and rolled back, 2 failed and not rolled back.
    p="$2"; path=""; after=10; norb=""; url=""; shift 2
    while [ $# -gt 0 ]; do
      case "$1" in
        --path) path="${2:?Usage: deploys verify <project> --path /health}"; shift ;;
        --rollback-after) after="${2:-}"; shift ;;
        --no-rollback) norb=1 ;;
        --url) url="${2:?Usage: deploys verify <project> --url https://…}"; shift ;;
        *) die "Unknown option $1. Usage: deploys verify <project> [--path /health] [--rollback-after 10] [--no-rollback] [--url <address>] [--json]" ;;
      esac
      shift
    done
    case "$after" in ''|*[!0-9]*) die "--rollback-after takes seconds, a number";; esac
    plat="$(platform_of "$p")"
    # A check while the build still runs would test what was live before.
    "$0" watch "$p" >&2 || die "The newest deploy of $p is not live; nothing to check"
    [ -n "$url" ] || url="$(site_url_of "$p" "$plat")"
    [ -n "$url" ] || die "No address known for $p (give one with --url)"
    case "$path" in ''|/*) ;; *) path="/$path";; esac
    target="${url%/}$path"; [ -n "$path" ] || target="$url"
    codes=""; bad=0
    for i in 1 2 3; do
      c="$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 10 --max-time 20 -A "DeployCenter (verify)" "$target" 2>/dev/null)" || true
      [ -n "$c" ] || c=000
      codes="$codes${codes:+ }$c"
      case "$c" in 000|5*) bad=$((bad + 1));; esac
      echo "$(date +%H:%M:%S)  $c  $target" >&2
      [ "$i" = 3 ] || sleep 5
    done
    report() {  # report <healthy> <rolledBack> <cancelled> <exit code>
      if [ "$json" = 1 ]; then
        jq -n --arg p "$p" --arg u "$target" --arg c "$codes" --argjson h "$1" --argjson r "$2" --argjson x "$3" \
          '{project:$p, url:$u, codes:($c | split(" ") | map(tonumber)), healthy:$h, rolledBack:$r, cancelled:$x}'
      fi
      exit "$4"
    }
    if [ "$bad" -lt 3 ]; then
      [ "$json" = 1 ] || echo "${GREEN}ok${PLAIN}: $p answers ($codes)."
      report true false false 0
    fi
    [ "$json" = 1 ] || echo "${RED}$p fails its check${PLAIN} ($codes from $target)."
    if [ -n "$norb" ]; then [ "$json" = 1 ] || echo "Not rolled back (--no-rollback)."; report false false false 2; fi
    stop=""; trap 'stop=1' INT TERM
    for ((s = after; s > 0; s--)); do
      printf '\rRolling back %s in %2d s – Ctrl-C to stop ' "$p" "$s" >&2
      sleep 1
      [ -z "$stop" ] || break
    done
    trap - INT TERM
    [ "$after" = 0 ] || echo >&2
    if [ -n "$stop" ]; then
      [ "$json" = 1 ] || echo "Rollback stopped; $p stays on the deploy that failed its check."
      journal_add "$plat" "$p" skipped "Check failed ($codes), rollback stopped by hand"
      report false false true 2
    fi
    if out="$("$0" "$plat" rollback "$p" 2>&1)"; then
      journal_add "$plat" "$p" other "Rolled back: $target answered $codes"
      [ "$json" = 1 ] || echo "Rolled back $p to the deploy before."
      report false true false 1
    fi
    echo "$out" >&2
    journal_add "$plat" "$p" failed "Check failed ($codes) and the rollback failed too"
    report false false false 2 ;;

  "risk "*)
    # risk <project>: green, yellow or red for what waits to go live, and why (see RISK_DEF).
    p="$2"; plat="$(platform_of "$p")"
    j="$("$0" "$plat" json | jq -c --arg p "$p" '.[] | select(.name == $p)')"
    [ -n "$j" ] || die "$p not found"
    repo="$(echo "$j" | jq -r '.repo // empty')"; [ -n "$repo" ] || die "$p has no known repo"
    base="$(echo "$j" | jq -r '.lastSha // empty')"; ref="$(echo "$j" | jq -r '.ref // "main"')"
    if [ -z "$base" ]; then r='{"level":"unknown","reasons":[],"files":0,"lines":0,"why":"the live commit is not known"}'
    elif [ "$base" = "$(echo "$j" | jq -r '.headSha // empty')" ]; then r='{"level":"green","reasons":[],"files":0,"lines":0,"why":"nothing waits"}'
    else
      cmp="$(gh api --cache 5m "repos/$repo/compare/$base...$ref" 2>/dev/null | jq -c 'del(.files[]?.patch)' 2>/dev/null)" \
        || die "GitHub could not compare what is live with $ref (rewritten branch, or gh not logged in?)"
      r="$(echo "$cmp" | jq -c "$RISK_DEF"' risk')"
    fi
    r="$(echo "$r" | jq -c --arg p "$p" --arg pl "$plat" '{project:$p, platform:$pl} + .')"
    if [ "$json" = 1 ]; then echo "$r" | jq .; exit 0; fi
    lv="$(echo "$r" | jq -r .level)"
    case "$lv" in red) c="$RED";; green) c="$GREEN";; *) c="$BOLD";; esac
    echo "$c$lv$PLAIN  $p$(echo "$r" | jq -r 'if .why then " (\(.why))" else " (\(.files) files, \(.lines) lines)" end')"
    echo "$r" | jq -r '.reasons[] | "  \(.level)  \(.text)"' ;;

  "deploy-changed "*)
    # The daily deploy: everything with changes. Without --yes it only shows what it would do.
    # Only what is known to have changes is started; what could not be read is named and left out.
    # --when-green: only commits whose CI passed; pending checks are waited for (--wait, default 30m).
    yes=""; green=""; maxw=1800
    shift
    while [ $# -gt 0 ]; do
      case "$1" in
        --yes) yes=1 ;;
        --when-green) green=1 ;;
        --wait) maxw="$(duration_s "${2:-}")" || die "--wait takes a time like 30m, 90s or 1h"; shift ;;
        *) die "Unknown option $1. Usage: deploys deploy-changed [--yes] [--when-green [--wait 30m]] [--force \"why\"] [--json]" ;;
      esac
      shift
    done
    rc=0; list="$(changed_json)" || rc=$?; n="$(echo "$list" | jq length)"
    if [ "$n" = "0" ]; then
      [ "$rc" = 0 ] || die "Could not tell what has changes (see above). Nothing was started."
      if [ "$json" = 1 ]; then echo '[]'; else echo "Nothing to deploy."; fi; exit 0
    fi
    if [ -z "$yes" ]; then
      if [ "$json" = 1 ]; then
        echo "$list" | jq '[.[] | {platform, name, sha:(.headSha // null), action:"would-deploy", commits:(.pendingCommits // null), risk:(.risk.level // null)}]'
        exit "$rc"
      fi
      echo "$list" | jq -r '.[] | "  \(.platform)  \(.name)  (\(.pendingCommits // "?") commits)\(if .risk.level == "red" then "  risk: \(.risk.reasons | map(select(.level == "red") | .text) | join("; "))" else "" end)"'
      w="$(window_json)"; [ "$(echo "$w" | jq -r .denied)" = true ] && echo "The deploy window is closed now ($(echo "$w" | jq -r .reason)): --yes needs --force \"why\"."
      echo "Would deploy these $n$([ -n "$green" ] && echo " whose checks pass"). Run again with --yes to start them."; exit "$rc"
    fi
    freeze_check
    res="$(mktemp)"; ok=0; bad=0; skip=0
    # say <platform> <name> <action> <reason> [<start JSON>]: one line for a person, one record for --json.
    say() {
      local plat="$1" name="$2" act="$3" why="$4" st="${5:-}" P
      [ -n "$st" ] || st="{}"  # not ${5:-{\}}: bash 3.2 keeps the backslash
      case "$plat" in vercel) P=Vercel;; render) P=Render;; *) P="$plat";; esac
      jq -nc --arg p "$plat" --arg n "$name" --arg a "$act" --arg w "$why" --argjson s "$st" \
        '{platform:$p, name:$n, action:$a, reason:(if $w == "" then null else $w end), id:($s.id // null), url:($s.url // null)}' >> "$res"
      [ "$json" = 1 ] && return 0
      case "$act" in
        started) if [ "$plat" = vercel ]; then echo "$P: $name started -> $(echo "$st" | jq -r .url)"; else echo "$P: $name started ($(echo "$st" | jq -r .id))"; fi ;;
        failed) echo "$P: $name failed to start" >&2 ;;
        skipped) echo "$P: $name skipped: $why" ;;
      esac
    }
    start() {  # start <platform> <name> <sha or empty> <reason>
      local st
      if st="$(deploy_one "$1" "$2" "$3" </dev/null)"; then ok=$((ok+1)); say "$1" "$2" started "$4" "$(echo "$st" | jq -c .)"; journal_forced "$1" "$2"
      else bad=$((bad+1)); say "$1" "$2" failed "$4"; fi
    }
    todo="$(echo "$list" | jq -r '.[] | "\(.platform)\t\(.name)\t\(.repo // "")\t\(.headSha // "")"')"
    if [ -z "$green" ]; then
      while IFS=$'\t' read -r plat name _ _; do start "$plat" "$name" "" ""; done <<< "$todo"
    else
      # Every project is asked in rounds, so one slow CI does not hold up the others; each starts
      # as soon as its own commit is green, at exactly that commit (a newer push waits for the next run).
      waited=0; delay=10
      while [ -n "$todo" ]; do
        next=""
        while IFS=$'\t' read -r plat name repo sha; do
          if [ -z "$repo" ] || [ -z "$sha" ]; then skip=$((skip+1)); say "$plat" "$name" skipped "the commit or repo is unknown, so its checks are too"; continue; fi
          v="$(ci_of "$repo" "$sha" </dev/null)"; s="$(echo "$v" | jq -r .state)"; why="$(echo "$v" | jq -r .reason)"
          case "$s" in
            green|none) start "$plat" "$name" "$sha" "$why" ;;
            red) skip=$((skip+1)); say "$plat" "$name" skipped "CI is red on ${sha:0:7} ($why)" ;;
            *) if [ "$waited" -ge "$maxw" ]; then skip=$((skip+1)); say "$plat" "$name" skipped "checks on ${sha:0:7} not done after $((maxw / 60))m ($why)"
               else next="$next$plat"$'\t'"$name"$'\t'"$repo"$'\t'"$sha"$'\n'; fi ;;
          esac
        done <<< "$todo"
        todo="${next%$'\n'}"
        [ -n "$todo" ] || break
        [ $((waited + delay)) -le "$maxw" ] || delay=$(( maxw - waited ))
        [ "$json" = 1 ] || echo "Waiting for checks on $(echo "$todo" | cut -f2 | paste -sd, - | sed 's/,/, /g'); next look in ${delay}s." >&2
        sleep "$delay"; waited=$((waited + delay)); delay=$(( delay * 2 > 120 ? 120 : delay * 2 ))
      done
    fi
    if [ "$json" = 1 ]; then jq -s '.' "$res"
    else echo "$ok started, $bad failed to start$([ -n "$green" ] && echo ", $skip skipped")."; fi
    rm -f "$res"
    [ "$rc" = 0 ] || echo "Some projects could not be read and were left out (see above)." >&2
    [ "$bad" = "0" ] && [ "$rc" = 0 ] ;;

  "vercel map")
    # Say by hand where a project deploys from, for one disconnected before this tool knew it.
    p="${3:?project}"; r="${4:?owner/repo}"; ref="${5:-main}"
    case "$r" in */*) ;; *) die "Give the repo as owner/name";; esac
    if [ "$(githost_of "$r")" = gitlab ]; then
      # GitLab: host/group/name (or its URL). Vercel deploys it by project id.
      read -r glh glp < <(githost_split "$r"); r="$glh/$glp"
      pid="$(gitlab_project_id "$r" || true)"; [ -n "$pid" ] || die "GitLab project $r not found (is glab logged in, or GITLAB_TOKEN set?)"
      tmp="$(mktemp)"
      jq --arg p "$p" --arg r "$r" --arg ref "$ref" --argjson pid "$pid" \
        '.[$p] = ({type:"gitlab", repo:$r, projectId:$pid, ref:$ref} + (if .[$p].offAt then {offAt:.[$p].offAt} else {} end))' "$REPOS" > "$tmp" && mv "$tmp" "$REPOS"
      echo "Vercel: $p deploys from $r ($ref)"; exit 0
    fi
    rid=""; command -v gh >/dev/null 2>&1 && rid="$(gh api "repos/$r" --jq .id 2>/dev/null || true)"
    tmp="$(mktemp)"
    # The whole entry is replaced: an old repoId would win over the new repo name.
    jq --arg p "$p" --arg o "${r%%/*}" --arg n "${r#*/}" --arg ref "$ref" --arg rid "$rid" \
      '.[$p] = ({org:$o, repo:$n, ref:$ref} + (if .[$p].offAt then {offAt:.[$p].offAt} else {} end)
                + (if $rid != "" then {repoId:($rid|tonumber)} else {} end))' "$REPOS" > "$tmp" && mv "$tmp" "$REPOS"
    echo "Vercel: $p deploys from $r ($ref)" ;;

  "vercel list")
    vercel_projects | jq -r '.[] | [.name, (if .link then "AUTO (\(.link.org // "")/\(.link.repo // ""))" else "manual" end)] | @tsv' \
      | column -t -s $'\t' ;;
  "vercel autodeploy-off")
    target="${3:-}"; [ -n "$target" ] || die "Give a project name or --all"
    if [ "$target" = "--all" ]; then
      # One that fails does not stop the rest; they are counted and the exit code says so.
      # The list first, on its own line: a failed read must stop here (set -e), not look like "none left".
      bad=0; names="$(vercel_projects | jq -r '.[] | select(.link) | .name')"
      for p in $names; do ( vercel_off "$p" ) || bad=$((bad + 1)); done
      [ "$bad" = 0 ] || die "$bad Vercel projects could not be disconnected (see above); the others are done"
      echo "Done. No Vercel project deploys on push any more."
    else
      vercel_off "$target"
    fi ;;
  "vercel autodeploy-on")
    # Connect Git again from the remembered repo. Every push builds again (and costs again).
    target="${3:-}"; [ -n "$target" ] || die "Give a project name or --all"
    if [ "$target" = "--all" ]; then
      bad=0; skipped=0; names="$(vercel_projects | jq -r '.[] | select(.link | not) | .name')"
      for p in $names; do
        if ! jq -e --arg n "$p" '.[$n].repo != null' "$REPOS" >/dev/null; then skipped=$((skipped + 1)); echo "Vercel: $p skipped, its repo is not known (deploys vercel map)"; continue; fi
        ( vercel_on "$p" ) || bad=$((bad + 1))
      done
      [ "$bad" = 0 ] || die "$bad Vercel projects could not be connected (see above); the others are done"
      echo "Done. Every remembered Vercel project deploys on push again."
    else
      vercel_on "$target"
    fi ;;
  "vercel deploy")
    # vercel deploy <project> [--preview] [--sha <commit>] [--wait]
    target="$3"; pv=""; sha=""; wait_=""; shift 3
    while [ $# -gt 0 ]; do
      case "$1" in
        --preview) pv=1;; --wait) wait_=1;;
        --sha) [ -n "${2:-}" ] || die "Usage: deploys vercel deploy <project> --sha <commit>"; sha="$2"; shift;;
        *) die "Unknown option $1. Usage: deploys vercel deploy <project> [--preview] [--sha <commit>] [--wait]";;
      esac; shift
    done
