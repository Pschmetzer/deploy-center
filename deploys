compdef _deploys deploys
ZSH
      ;;
      bash) cat <<BASH
_deploys() {
  local cur=\${COMP_WORDS[COMP_CWORD]}
  if [ \$COMP_CWORD -eq 1 ]; then COMPREPLY=(\$(compgen -W "$cmds" -- "\$cur"))
${bv}  elif [ \$COMP_CWORD -eq 2 ] && [ "\${COMP_WORDS[1]}" = ai ]; then COMPREPLY=(\$(compgen -W "explain notes ship set-key forget-key verify model cap status" -- "\$cur"))
  else
    # Matched by hand, not with compgen -W: that expands each word, and a name is data.
    local n; COMPREPLY=()
