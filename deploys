    safe_arg "$p"; resolve "$p"; plat="$PLAT"; pq="$p"; p="$PNAME"
    # A check while the build still runs would test what was live before.
    "$SELF" watch "$pq" >&2 || die "The newest deploy of $p is not live; nothing to check"
