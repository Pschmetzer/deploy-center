  "render deploy-json")
    # deploy-json <service> [--sha <commit>] [--clear-cache]
    freeze_check
    name="${3:?service}"; id="$(render_id_of "$name")"; sha=""; cc=""; shift 3 || true
    while [ $# -gt 0 ]; do case "$1" in --sha) sha="${2:?commit}"; shift;; --clear-cache) cc=1;; esac; shift; done
    # Production waits for its approvals (two-person rule); the commit checked is the one deployed.
    if team_on; then
      svc="$(render_call GET "/services/$id")" || exit 1
