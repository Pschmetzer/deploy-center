        --follow) follow=(-L --max-redirs 3) ;;
        *) die "Unknown option $1. Usage: deploys verify <project> [--path /health] [--expect 200|2xx] [--follow] [--rollback-after 10] [--no-rollback] [--url <address>] [--json]" ;;
      esac
      shift
    done
    case "$after" in ''|*[!0-9]*) die "--rollback-after takes seconds, a number";; esac
