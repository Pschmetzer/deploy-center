#!/bin/bash
# deploys — turn off auto-deploy on Vercel and Render, then deploy by hand.
#
# Why: every git push builds every project. Build minutes cost money.
# Deploying once a day by hand costs a fraction.
#
# Access:
#   Vercel  the `vercel` CLI login on this Mac (`vercel login`).
#   Render  an API key in the macOS keychain (`deploys render set-key`, reads stdin).
# No key is ever printed.
#
# Commands:
#   deploys doctor                            check tools and access (JSON)
#   deploys changed [--json]                  what has commits on GitHub that are not live
#   deploys deploy-changed [--yes]            deploy all of those (shows the list without --yes)
#   deploys vercel map <p> <owner/repo> [br]  say where a project deploys from
#   deploys vercel list                       projects and whether a push still deploys them
#   deploys vercel autodeploy-off <p>|--all   disconnect Git (remembers the repo first)
#   deploys vercel deploy <p> [--preview]     deploy the newest commit of the remembered repo
#   deploys vercel rollback <p>               production back to the previous deployment
#   deploys render rollback <service>          back to the deploy that was live before
#   deploys vercel team [<id>]                show or set the Vercel team
#   deploys render list                       services and their auto-deploy setting
#   deploys render autodeploy-off <s>|--all
#   deploys render deploy <service>           deploy the newest commit
#   deploys render set-key                    store the Render API key (read from stdin)
#
# Config lives in ${DEPLOYS_CONFIG:-~/.config/deploys}:
#   vercel-repos.json  which repo/branch each Vercel project deploys from
#   vercel-team        team id (auto-detected; empty for a personal account)

set -euo pipefail

CONFIG_DIR="${DEPLOYS_CONFIG:-$HOME/.config/deploys}"
REPOS="$CONFIG_DIR/vercel-repos.json"
RENDER_API="https://api.render.com/v1"
KEYCHAIN_SERVICE="deploy-center-render"
LEGACY_KEYCHAIN_SERVICE="render-api-key"

mkdir -p "$CONFIG_DIR"
[ -f "$REPOS" ] || echo '{}' > "$REPOS"

die() { echo "Error: ${RED}$*${PLAIN}" >&2; exit 1; }

# Colour only for a person at a terminal, never in what the app or a pipe reads.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then RED=$'\033[31m'; GREEN=$'\033[32m'; BOLD=$'\033[1m'; PLAIN=$'\033[0m'
else RED=""; GREEN=""; BOLD=""; PLAIN=""; fi

# --json anywhere asks for the machine answer: `vercel list --json` is `vercel json`,
# `vercel deploy p --json` is `vercel deploy-json p`. The old spellings keep working.
json=0
args=()
for a in "$@"; do if [ "$a" = "--json" ]; then json=1; else args+=("$a"); fi; done
if [ "$json" = 1 ]; then
  case "${args[0]:-} ${args[1]:-}" in
    "vercel list"|"render list") args[1]="json" ;;
    "vercel deploy"|"render deploy") args[1]="deploy-json" ;;
  esac
  [ "${args[0]:-}" = "changed" ] && args=("changed" "--json")
fi
set -- ${args[@]+"${args[@]}"}

# Which platform a name belongs to: a Vercel project first, then a Render service.
platform_of() {
  if vercel_call "/v9/projects/$1" >/dev/null 2>&1; then echo vercel
  elif render_key >/dev/null 2>&1 && render_id_of "$1" >/dev/null 2>&1; then echo render
  else die "No Vercel project or Render service named \"$1\""; fi
}

# ---------- Vercel ----------

# The team the commands act on. Detected once and remembered; a personal account has none.
vercel_team() {
  if [ -n "${DEPLOYS_VERCEL_TEAM:-}" ]; then echo "$DEPLOYS_VERCEL_TEAM"; return; fi
  if [ -f "$CONFIG_DIR/vercel-team" ]; then cat "$CONFIG_DIR/vercel-team"; return; fi
  local teams n
  teams="$(vercel api /v2/teams 2>/dev/null)" || die "The vercel CLI is not logged in. Run: vercel login"
  n="$(echo "$teams" | jq '.teams | length')"
  if [ "$n" = "0" ]; then
    : > "$CONFIG_DIR/vercel-team"; echo ""
  elif [ "$n" = "1" ]; then
    echo "$teams" | jq -r '.teams[0].id' | tr -d '\n' | tee "$CONFIG_DIR/vercel-team"
  else
    echo "$teams" | jq -r '.teams[] | "  \(.id)  \(.slug)"' >&2
    die "Several Vercel teams. Choose one: deploys vercel team <id>"
  fi
}

# Query string for the team, empty for a personal account.
team_q() { local t; t="$(vercel_team)"; [ -n "$t" ] && echo "teamId=$t" || echo ""; }
with_team() { local q; q="$(team_q)"; case "$1" in *\?*) echo "$1${q:+&$q}";; *) echo "$1${q:+?$q}";; esac; }

vercel_call() { vercel api "$(with_team "$1")" "${@:2}" 2>/dev/null; }

vercel_projects() {
  local all="[]" page next="" url
  while :; do
    url="/v10/projects?limit=100${next:+&until=$next}"
    page="$(vercel_call "$url")" || die "Could not list Vercel projects"
    all="$(jq -s '.[0] + .[1].projects' <(echo "$all") <(echo "$page"))"
    next="$(echo "$page" | jq -r '.pagination.next // empty')"
    [ -n "$next" ] || break
  done
  echo "$all"
}

# Write down where a project deploys from. Only ever adds; an entry once known is kept.
remember_repo() {
  local entry="$1" tmp
  tmp="$(mktemp)"
  jq --argjson e "$entry" '. + ($e | with_entries(select(.value.repo != null)))' "$REPOS" > "$tmp" && mv "$tmp" "$REPOS"
}

vercel_off() {
  local p="$1" info
  info="$(vercel_call "/v9/projects/$p")" || die "Vercel project $p not found"
  # The link is the only place the repo is written down. Keep it before removing it.
  remember_repo "$(echo "$info" | jq --arg p "$p" '{($p): (.link // {}) | {org, repo, repoId, ref:(.productionBranch // "main"), offAt:now|floor}}')"
  [ "$(echo "$info" | jq '.link != null')" = "true" ] || { echo "Vercel: $p was already manual"; return; }
  vercel api "$(with_team "/v9/projects/$p/link")" --method DELETE --dangerously-skip-permissions >/dev/null 2>&1 \
    || die "Vercel: could not disconnect $p"
  echo "Vercel: $p no longer deploys on push"
}

# A start that is already under way for the same project is refused, across the app and the
# terminal: two quick clicks, or the app and a script at once, would pay for two builds.
start_lock() {
  local d="$CONFIG_DIR/locks" f; mkdir -p "$d"; f="$d/$(echo "$1" | tr '/ ' '__')"
  if [ -f "$f" ] && [ $(( $(date +%s) - $(stat -f %m "$f") )) -lt 60 ]; then die "$1 is being started already (wait a minute)"; fi
  touch "$f"; echo "$f"
}

vercel_deploy_json() {
  local target="$1" preview="${2:-}" sha="${3:-}" body out lock
  jq -e --arg p "$target" 'has($p)' "$REPOS" >/dev/null || die "$target has no remembered repo. Turn its auto-deploy off with this tool, or add it to $REPOS"
  lock="$(start_lock "vercel-$target")"
  body="$(mktemp)"; trap 'rm -f "$body" "$lock"' RETURN
  jq --arg p "$target" --arg prev "$preview" --arg sha "$sha" '.[$p] as $r | {name:$p, project:$p}
    + (if $prev == "" then {target:"production"} else {} end)
    + {gitSource:({type:"github", ref:$r.ref} + (if $r.repoId then {repoId:$r.repoId} else {org:$r.org, repo:$r.repo} end)
                  + (if $sha != "" then {sha:$sha} else {} end))}' "$REPOS" > "$body"
  local errf; errf="$(mktemp)"
  out="$(vercel api "$(with_team /v13/deployments)" --method POST --input "$body" 2>"$errf")" \
    || { local e; e="$(tail -c 400 "$errf")"; rm -f "$errf"; die "Vercel: $e $(echo "$out" | jq -r '.error.message // empty' 2>/dev/null)"; }
  rm -f "$errf"
  echo "$out" | jq -e '.id' >/dev/null 2>&1 || die "Vercel: $(echo "$out" | head -c 400)"
  echo "$out" | jq '{id, url:("https://" + .url), state:(.readyState // .status)}'
}

# ---------- GitHub (optional, for "new changes") ----------

head_of() {
  local repo="$1" ref="$2" out="$3"
  gh api "repos/$repo/commits/$ref" 2>/dev/null \
    | jq -c --arg k "$repo@$ref" '{key:$k, value:{at:(.commit.committer.date|fromdateiso8601), msg:(.commit.message|split("\n")[0]), sha:.sha}}' \
    > "$out/$(echo "$repo@$ref" | tr '/@' '__').json" 2>/dev/null || true
}
export -f head_of

# What is merged but not live: commits from the live commit to the branch, and the pull
# requests among them (squash "(#12)" or "Merge pull request #12"). ahead_by is exact;
# the PR count reads at most the 250 commits GitHub lists.
pending_of() {
  local repo="$1" base="$2" ref="$3" out="$4" key f cmp
  key="$repo@$base@$ref"; f="$out/$(echo "$key" | tr '/@' '__').json"
  # Cached for five minutes: a reload every quarter hour should not eat GitHub's hourly budget.
  if ! cmp="$(gh api --cache 5m "repos/$repo/compare/$base...$ref" 2>/dev/null)"; then
    # The live commit is gone from the repo: the branch was rewritten (force-push).
    printf '{"key":"%s","value":{"rewritten":true}}\n' "$key" > "$f"; return 0
  fi
  echo "$cmp" | jq -c --arg k "$key" '
      [.commits[] | {sha, n:(.commit.message | (capture("\\(#(?<n>[0-9]+)\\)") // capture("Merge pull request #(?<n>[0-9]+)")) | .n)}] as $c
      | {key:$k, value:{commits:.ahead_by,
          prs:([$c[] | .n // empty] | unique | length),
          # GitHub lists 250 commits at most; past that the PR count is a floor.
          partial:(.ahead_by > (.commits | length)),
          oldestAt:(.commits[0].commit.committer.date // null | if . then fromdateiso8601 else null end),
          bare:([$c[] | select(.n == null) | .sha])}}' > "$f" 2>/dev/null || return 0
  # A rebase merge leaves no number in the message. For a few such commits, ask which PR they came from.
  local bare n
  bare="$(jq -r '.value.bare | if length <= 10 then .[] else empty end' "$f")"
  if [ -n "$bare" ]; then
    n="$(for s in $bare; do gh api --cache 24h "repos/$repo/commits/$s/pulls" --jq '.[].number' 2>/dev/null; done | sort -u | wc -l | tr -d ' ')"
    jq -c --argjson n "$n" '.value.prs += $n | del(.value.bare)' "$f" > "$f.t" && mv "$f.t" "$f"
  else
    jq -c 'del(.value.bare)' "$f" > "$f.t" && mv "$f.t" "$f"
  fi
}
export -f pending_of

# Pull requests still open on the repo: not merged, so not deployable yet either.
# Drafts and bots (Dependabot, Renovate) counted apart, since they rarely mean "ship soon".
open_prs_of() {
  local repo="$1" out="$2"
  gh api --cache 5m "repos/$repo/pulls?state=open&per_page=100" \
    --jq "{key:\"$repo\", value:{all:length, drafts:(map(select(.draft)) | length), bots:(map(select(.user.type==\"Bot\")) | length)}}" \
    > "$out/$(echo "$repo" | tr '/' '_').json" 2>/dev/null || true
}
export -f open_prs_of

# The one rule for "has changes to deploy", read by `changed`, `deploy-changed` and the app.
# Not deployable, paused, already building, or with no known head: not changed.
CHANGED_RULE='map(. + {building: ([.lastState, .latestState] | map(. // "" | ascii_downcase)
    | any(. as $s | ["building","queued","initializing","created","build_in_progress","update_in_progress","pre_deploy_in_progress"] | index($s)))})
  | map(. + {changed: (
  (.deployable // false) and ((.paused // false) | not) and (.headSha != null or .headAt != null)
  and (.building | not)
  and (if .lastSha and .headSha then .lastSha != .headSha else (.headAt // 0) > (.lastAt // 0) end))})'

with_heads() {
  local list="$1" tmp heads pend opens
  if ! command -v gh >/dev/null 2>&1; then echo "$list" | jq "$CHANGED_RULE"; return; fi
  tmp="$(mktemp -d)"; mkdir "$tmp/h" "$tmp/p" "$tmp/o"
  echo "$list" | jq -r '.[] | select(.repo and .ref) | "\(.repo) \(.ref)"' | sort -u \
    | xargs -P 8 -n 2 bash -c 'head_of "$0" "$1" "'"$tmp/h"'"'
  heads="$(cat "$tmp/h"/*.json 2>/dev/null | jq -s 'from_entries')"
  list="$(echo "$list" | jq --argjson h "${heads:-{\}}" 'map(. + (($h["\(.repo)@\(.ref)"] // {}) | {headAt:.at, headMsg:.msg, headSha:.sha}))')"
  # With GitHub's budget nearly spent, keep it for what decides "changed" (the heads above).
  local left; left="$(github_budget | jq -r '.remaining // 5000' 2>/dev/null || echo 5000)"
  if [ "${left:-5000}" -lt 300 ]; then rm -rf "$tmp"; echo "$list" | jq "$CHANGED_RULE"; return; fi
  # Compared only where the branch moved past the live commit.
  echo "$list" | jq -r '.[] | select(.repo and .ref and .lastSha and .headSha and .lastSha != .headSha) | "\(.repo) \(.lastSha) \(.ref)"' \
    | sort -u | xargs -P 8 -n 3 bash -c 'pending_of "$0" "$1" "$2" "'"$tmp/p"'"'
  echo "$list" | jq -r '.[] | .repo // empty' | sort -u | xargs -P 8 -n 1 bash -c 'open_prs_of "$0" "'"$tmp/o"'"'
  pend="$(cat "$tmp/p"/*.json 2>/dev/null | jq -s 'from_entries')"
  opens="$(cat "$tmp/o"/*.json 2>/dev/null | jq -s 'from_entries')"
  rm -rf "$tmp"
  echo "$list" | jq --argjson p "${pend:-{\}}" --argjson o "${opens:-{\}}" 'map(
      (if .lastSha and .headSha and .lastSha == .headSha then {commits:0, prs:0} else ($p["\(.repo)@\(.lastSha)@\(.ref)"] // {}) end) as $x
      | ($o[.repo // ""] // {}) as $op
      | . + {pendingCommits:($x.commits // null), pendingPRs:($x.prs // null), pendingPartial:($x.partial // false),
             oldestPendingAt:($x.oldestAt // null), rewritten:($x.rewritten // false),
             openPRs:($op.all // null), openDrafts:($op.drafts // null), openBots:($op.bots // null)})' \
    | jq "$CHANGED_RULE"
}

# Names for tab completion, kept up to date by every list read.
remember_names() { jq -r '.[].name' 2>/dev/null >> "$CONFIG_DIR/names.tmp"; sort -u "$CONFIG_DIR/names.tmp" > "$CONFIG_DIR/names" 2>/dev/null; }

# Every project with changes, both platforms, each marked with its platform. Both read at once.
changed_json() {
  local t; t="$(mktemp -d)"
  ( "$0" vercel json 2>/dev/null | jq 'map(. + {platform:"vercel"})' > "$t/v.json" || echo '[]' > "$t/v.json" ) &
  if render_key >/dev/null 2>&1; then
    ( "$0" render json 2>/dev/null | jq 'map(. + {platform:"render"})' > "$t/r.json" || echo '[]' > "$t/r.json" ) &
  fi
  wait
  local ign="$CONFIG_DIR/ignored.json"; [ -f "$ign" ] || echo '[]' > "$ign"
  cat "$t"/*.json 2>/dev/null | jq -s --slurpfile ign "$ign" 'add // [] | map(select(.changed and ((.name as $n | $ign[0] | index($n)) | not)))'
  rm -rf "$t"
}

# What is left of GitHub's hourly budget for the gh login, as {remaining, limit, reset}.
github_budget() { gh api rate_limit --jq '.resources.core | {remaining, limit, reset}' 2>/dev/null || echo 'null'; }

# ---------- Render ----------

render_key() {
  # On a server or in CI there is no keychain: the key may come from the environment.
  if [ -n "${RENDER_API_KEY:-}" ]; then printf '%s' "$RENDER_API_KEY"; return; fi
  security find-generic-password -a "$USER" -s "$KEYCHAIN_SERVICE" -w 2>/dev/null \
    || security find-generic-password -a "$USER" -s "$LEGACY_KEYCHAIN_SERVICE" -w 2>/dev/null \
    || die "No Render API key. Create one at dashboard.render.com > Account Settings > API Keys, then: deploys render set-key"
}
export KEYCHAIN_SERVICE LEGACY_KEYCHAIN_SERVICE

# The key goes to curl on stdin so it never shows in the process list.
render_call() {
  local method="$1" path="$2" body="${3:-}" key out code
  key="$(render_key)"
  local args=(-sS -X "$method" -H "Accept: application/json" -K -)
  [ -n "$body" ] && args+=(-H "Content-Type: application/json" --data "$body")
  out="$(printf 'header = "Authorization: Bearer %s"\n' "$key" | curl "${args[@]}" -w '\n%{http_code}' "$RENDER_API$path")"
  code="${out##*$'\n'}"; out="${out%$'\n'*}"
  [[ "$code" == 2* ]] || die "Render $method $path -> HTTP $code: $out"
  printf '%s' "$out"
}

render_services() {
  local cursor="" page all="[]"
  while :; do
    page="$(render_call GET "/services?limit=100${cursor:+&cursor=$cursor}")"
    all="$(jq -s '.[0] + .[1]' <(echo "$all") <(echo "$page"))"
    [ "$(echo "$page" | jq 'length')" -lt 100 ] && break
    cursor="$(echo "$page" | jq -r '.[-1].cursor')"
  done
  echo "$all" | jq '[.[].service]'
}

render_auto() { echo '(.autoDeployTrigger // (if .autoDeploy=="yes" then "commit" else "off" end))'; }

render_id_of() {
  local name="$1" id
  case "$name" in srv-*|crn-*) echo "$name"; return;; esac
  id="$(render_services | jq -r --arg n "$name" '.[] | select(.name==$n) | .id')"
  [ -n "$id" ] || die "No Render service named \"$name\". See: deploys render list"
  echo "$id"
}

render_off() {
  render_call PATCH "/services/$1" '{"autoDeployTrigger":"off"}' >/dev/null
  # When it was turned off, so a later push-triggered build can be told apart from earlier ones.
  local f="$CONFIG_DIR/render-off.json" tmp; [ -f "$f" ] || echo '{}' > "$f"; tmp="$(mktemp)"
  jq --arg id "$1" '.[$id] = (.[$id] // (now|floor))' "$f" > "$tmp" && mv "$tmp" "$f"
  echo "Render: $2 no longer deploys on push"
}

# The key comes from a 0600 file the caller wrote once, so twenty services do not mean
# twenty keychain reads (or twenty permission prompts).
render_last_of() {
  local id="$1" out="$2" key
  key="$(cat "$3" 2>/dev/null)"; [ -n "$key" ] || return 0
  printf 'header = "Authorization: Bearer %s"\n' "$key" \
    | curl -sS -K - -H "Accept: application/json" "https://api.render.com/v1/services/$id/deploys?limit=10" \
    | jq -c --arg id "$id" 'def t: (. // null) | if . then (sub("\\.[0-9]+Z$";"Z")|fromdateiso8601) else null end;
        [.[].deploy] as $d | ($d[0] // {}) as $new | (($d | map(select(.status=="live")) | .[0]) // {}) as $live
        # The status is the newest attempt (a failure shows), the commit is what is live: a failed
        # deploy of the newest commit must not make the project look up to date.
        | {key:$id, value:{lastAt:(($new.finishedAt // $new.createdAt) | t), lastState:$new.status,
                           lastSha:($live.commit.id // null), lastMsg:($live.commit.message // null | if . then split("\n")[0] else null end), liveAt:(($live.finishedAt // $live.createdAt) | t)}}' \
    > "$out/$id.json" 2>/dev/null || true
}
export -f render_last_of

# ---------- Costs (Vercel billing, one UTC day per request) ----------

# One day of charges, summed: total, builds, and builds per project.
cost_day() {
  local from="$1" to="$2" team="$3" out="$4"
  vercel api "/v1/billing/charges?from=${from}T00:00:00.000Z&to=${to}T00:00:00.000Z${team:+&teamId=$team}" 2>/dev/null \
    | jq -sc --arg d "$from" '{day:$d,
        total:(map(.BilledCost) | add // 0),
        build:(map(select(.ServiceCategory=="Build & Deploy" or (.ServiceName|test("Build")))) | map(.BilledCost) | add // 0),
        projects:(map(select(.ServiceName|test("Build"))) | group_by(.Tags.ProjectName // "?")
          | map({name:(.[0].Tags.ProjectName // "?"), build:(map(.BilledCost)|add)}))}' \
    > "$out/$from.json" 2>/dev/null || true
}
export -f cost_day

# ---------- Other things that start builds ----------

# A workflow that deploys by itself defeats turning auto-deploy off.
workflow_hits() {
  local repo="$1" out="$2"
  gh api "repos/$repo/contents/.github/workflows" --jq '.[] | select(.type=="file") | .path' 2>/dev/null | while read -r f; do
    gh api "repos/$repo/contents/$f" --jq '.content' 2>/dev/null | base64 -D 2>/dev/null \
      | grep -vE '^[[:space:]]*#' \
      | grep -qE 'vercel (deploy|--prod)|vercel-action|api\.render\.com/deploy|render-deploy|deploy[-_]hook|DEPLOY_HOOK' \
      && printf '{"kind":"workflow","where":"%s","detail":"%s"}\n' "$repo" "$f"
  done > "$out/$(echo "$repo" | tr '/' '_').jsonl" || true
}
export -f workflow_hits

# ---------- Commands ----------

case "${1:-} ${2:-}" in
  "doctor "*)
    # Written with printf, not jq: this is the command that has to work when jq is missing.
    has() { command -v "$1" >/dev/null 2>&1 && echo true || echo false; }
    vapi=false; vercel api --help >/dev/null 2>&1 && vapi=true
    vlogin=false; vercel whoami >/dev/null 2>&1 && vlogin=true
    rkey=false; { security find-generic-password -a "$USER" -s "$KEYCHAIN_SERVICE" -w >/dev/null 2>&1 \
      || security find-generic-password -a "$USER" -s "$LEGACY_KEYCHAIN_SERVICE" -w >/dev/null 2>&1; } && rkey=true
    glogin=false; gh auth status >/dev/null 2>&1 && glogin=true
    printf '{"jq":%s,"vercelCli":%s,"vercelApi":%s,"vercelLoggedIn":%s,"githubCli":%s,"githubLoggedIn":%s,"renderKey":%s}\n' \
      "$(has jq)" "$(has vercel)" "$vapi" "$vlogin" "$(has gh)" "$glogin" "$rkey" ;;

  "github-budget "*)
    github_budget ;;

  "status "*)
    # What is building right now, on both platforms, and what the newest attempt said.
    t="$(mktemp -d)"
    ( "$0" vercel json 2>/dev/null | jq 'map(. + {platform:"vercel"})' > "$t/v.json" || echo '[]' > "$t/v.json" ) &
    if render_key >/dev/null 2>&1; then ( "$0" render json 2>/dev/null | jq 'map(. + {platform:"render"})' > "$t/r.json" || echo '[]' > "$t/r.json" ) & fi
    wait
    all="$(cat "$t"/*.json | jq -s 'add // []')"; rm -rf "$t"
    if [ "$json" = 1 ]; then echo "$all" | jq 'map({platform, name, building, state:(.latestState // .lastState), changed})'; exit 0; fi
    echo "$all" | jq -r '.[] | select(.building or ((.latestState // .lastState // "") | ascii_downcase | test("error|fail"))) | [.platform, .name, (.latestState // .lastState)] | @tsv' \
      | (printf 'PLATFORM\tPROJECT\tSTATE\n'; cat) | column -t -s $'\t'
    echo "$all" | jq -r '"\(map(select(.building)) | length) building, \(map(select(.changed)) | length) with changes."' ;;

  "watch "*)
    # Follow the newest deploy of one project until it is live or failed.
    p="${2:?project}"; plat="$(platform_of "$p")"
    while :; do
      if [ "$plat" = vercel ]; then
        s="$(vercel_call "/v6/deployments?app=$p&limit=1&target=production" | jq -r '.deployments[0].state // "?"')"
      else
        s="$(render_call GET "/services/$(render_id_of "$p")/deploys?limit=1" | jq -r '.[0].deploy.status // "?"')"
      fi
      printf '%s  %s\n' "$(date +%H:%M:%S)" "$s"
      case "$s" in READY|live|succeeded) exit 0;; ERROR|CANCELED|build_failed|update_failed|canceled|pre_deploy_failed|deactivated) exit 1;; esac
      sleep 6
    done ;;

  "logs "*)
    # The last lines of the newest build log of one project.
    p="${2:?project}"; n="${3:-80}"; plat="$(platform_of "$p")"
    if [ "$plat" = vercel ]; then
      d="$(vercel_call "/v6/deployments?app=$p&limit=1&target=production" | jq -r '.deployments[0].uid // empty')"
      [ -n "$d" ] || die "No deployment of $p"
      vercel_call "/v3/deployments/$d/events?builds=1&direction=backward&limit=2000" \
        | jq -r --argjson n "$n" 'sort_by(.created) | map(.payload.text // .text // "" | select(test("\\S"))) | .[-$n:][]'
    else
      id="$(render_id_of "$p")"; owner="$(render_call GET "/services/$id" | jq -r .ownerId)"
      render_call GET "/logs?ownerId=$owner&resource=$id&type=build&limit=$n&direction=backward" \
        | jq -r '.logs | reverse | .[].message' | sed $'s/\x1b\\[[0-9;]*m//g'
    fi ;;

  "open "*)
    # The site, or with --dashboard the project's page at Vercel or Render.
    p="${2:?project}"; plat="$(platform_of "$p")"
    if [ "$plat" = vercel ]; then
      if [ "${3:-}" = "--dashboard" ]; then
        slug="$(vercel_call "/v2/teams/$(vercel_team)" | jq -r '.slug // empty' 2>/dev/null)"
        url="https://vercel.com/${slug:+$slug/}$p"
      else
        url="$(vercel_call "/v9/projects/$p" | jq -r '((.targets.production.alias // []) | map(select(endswith(".vercel.app")|not)) | .[0]) // (.targets.production.alias[0] // empty) | "https://\(.)"')"
      fi
    else
      svc="$(render_call GET "/services/$(render_id_of "$p")")"
      if [ "${3:-}" = "--dashboard" ]; then url="$(echo "$svc" | jq -r '.dashboardUrl // empty')"
      else url="$(echo "$svc" | jq -r '.serviceDetails.url // .dashboardUrl // empty')"; fi
    fi
    [ -n "$url" ] || die "No address known for $p"
    open "$url" 2>/dev/null || echo "$url" ;;

  "ignore "*)
    # Leave a project out of `changed` and `deploy-changed` (again with: ignore <p> --undo).
    p="${2:?project}"; f="$CONFIG_DIR/ignored.json"; [ -f "$f" ] || echo '[]' > "$f"; tmp="$(mktemp)"
    if [ "${3:-}" = "--undo" ]; then jq --arg p "$p" 'map(select(. != $p))' "$f" > "$tmp"; echo "$p is counted again"
    else jq --arg p "$p" '. + [$p] | unique' "$f" > "$tmp"; echo "$p is left out of changed and deploy-changed"; fi
    mv "$tmp" "$f" ;;

  "completion "*)
    # Tab completion: eval "$(deploys completion zsh)" in ~/.zshrc, or bash in ~/.bashrc.
    cmds="doctor changed deploy-changed status watch logs open ignore costs triggers details vercel render completion"
    case "${2:-zsh}" in
      zsh) cat <<ZSH
_deploys() {
  local -a names; names=(\${(f)"\$(cat "$CONFIG_DIR/names" 2>/dev/null)"})
  if (( CURRENT == 2 )); then compadd $cmds
  elif [[ \$words[2] == (vercel|render) && CURRENT == 3 ]]; then compadd list deploy rollback status autodeploy-off json map
  else compadd -a names; fi
}
compdef _deploys deploys
ZSH
      ;;
      bash) cat <<BASH
_deploys() {
  local cur=\${COMP_WORDS[COMP_CWORD]}
  if [ \$COMP_CWORD -eq 1 ]; then COMPREPLY=(\$(compgen -W "$cmds" -- "\$cur"))
  else COMPREPLY=(\$(compgen -W "\$(cat "$CONFIG_DIR/names" 2>/dev/null)" -- "\$cur")); fi
}
complete -F _deploys deploys
BASH
      ;;
      *) die "zsh or bash" ;;
    esac ;;

  "details "*)
    # Everything about one repo the window shows on demand: the commits between what is live and
    # the branch (with their PRs), the files they touch and which of them are risky to ship
    # unread, the CI result of the branch head, and the pull requests still open.
    repo="${2:?owner/repo}"; base="${3:-}"; ref="${4:-main}"
    cmp='null'
    if [ -n "$base" ] && [ "$base" != "null" ]; then cmp="$(gh api --cache 5m "repos/$repo/compare/$base...$ref" 2>/dev/null || echo null)"; fi
    checks="$(gh api --cache 2m "repos/$repo/commits/$ref/check-runs?per_page=100" 2>/dev/null \
      | jq '{total:.total_count, failed:([.check_runs[] | select(.conclusion=="failure" or .conclusion=="timed_out" or .conclusion=="cancelled")] | length),
             running:([.check_runs[] | select(.status!="completed")] | length)}' 2>/dev/null || echo null)"
    open="$(gh pr list -R "$repo" --state open --limit 50 --json number,title,author,isDraft,updatedAt,url,statusCheckRollup 2>/dev/null \
      | jq '[.[] | {number, title, author:.author.login, bot:(.author.is_bot // (.author.login | test("\\[bot\\]|dependabot|renovate"))),
                    draft:.isDraft, updatedAt, url,
                    ci:(.statusCheckRollup // [] | map(.conclusion // .state // "") | map(ascii_upcase)
                        | if length == 0 then "none" elif any(. == "FAILURE" or . == "ERROR" or . == "TIMED_OUT") then "failed"
                          elif any(. == "" or . == "PENDING" or . == "IN_PROGRESS" or . == "QUEUED") then "running" else "passed" end)}]' 2>/dev/null || echo '[]')"
    jq -n --argjson c "$cmp" --argjson checks "$checks" --argjson open "$open" --arg repo "$repo" '
      ($c // {}) as $c |
      {commits:[($c.commits // [])[] | {sha:.sha[0:7], full:.sha, url:.html_url,
                 msg:(.commit.message | split("\n")[0]), author:(.author.login // .commit.author.name),
                 bot:((.author.type // "") == "Bot"),
                 at:(.commit.committer.date | fromdateiso8601),
                 pr:((.commit.message | (capture("\\(#(?<n>[0-9]+)\\)") // capture("Merge pull request #(?<n>[0-9]+)")) | .n | tonumber) // null)}] | reverse,
       files:(($c.files // []) | length), additions:(($c.files // []) | map(.additions) | add // 0),
       deletions:(($c.files // []) | map(.deletions) | add // 0),
       # Files that change how the thing runs, not only what it shows: worth a look before going live.
       risky:[($c.files // [])[] | .filename
              | select(test("(^|/)(migrations?|prisma)/|schema\\.(prisma|sql|rb)$|(^|/)\\.env|(^|/)(package\\.json|package-lock\\.json|pnpm-lock\\.yaml|yarn\\.lock|requirements\\.txt|Pipfile\\.lock|poetry\\.lock|go\\.mod|Gemfile\\.lock|Cargo\\.lock)$|Dockerfile|render\\.yaml$|vercel\\.json$|\\.github/workflows/"))],
       onlyBots:(($c.commits // []) | length > 0 and all((.author.type // "") == "Bot" or ((.author.login // "") | test("\\[bot\\]")))),
       compareUrl:($c.html_url // null),
       checks:$checks, open:$open}' ;;

  "costs "*)
    # Vercel charges for the last N days (default 7), per day and builds per project.
    days="${2:-7}"; team="$(vercel_team)"; tmp="$(mktemp -d)"
    for i in $(seq "$days" -1 1); do
      echo "$(date -u -v-"${i}"d +%Y-%m-%d) $(date -u -v-"$((i-1))"d +%Y-%m-%d)"
    done | xargs -P 4 -n 2 bash -c 'cost_day "$0" "$1" "'"$team"'" "'"$tmp"'"'
    # Builds per project over the last 7 days, to put a price on one build.
    since=$(( ($(date +%s) - 7*86400) * 1000 ))
    names="" next=""
    for _ in 1 2 3 4 5; do   # five pages of 100 at most
      page="$(vercel_call "/v6/deployments?limit=100&since=$since${next:+&until=$next}")" || break
      names="$names$(echo "$page" | jq -r '.deployments[].name')"$'\n'
      next="$(echo "$page" | jq -r '.pagination.next // empty')"; [ -n "$next" ] || break
    done
    # Past five pages the counts are short, and a price per build would be too high.
    complete=true; [ -n "$next" ] && complete=false
    builds="$(printf '%s' "$names" | jq -R -s 'split("\n") | map(select(. != "")) | group_by(.) | map({key:.[0], value:length}) | from_entries')"
    # The day auto-deploy was first turned off here: the line between "before" and "since".
    offday="$( { jq '[.[] | .offAt? // empty]' "$REPOS"; jq '[.[]]' "$CONFIG_DIR/render-off.json" 2>/dev/null || echo '[]'; } \
      | jq -rs 'add | map(select(type=="number")) | min // empty | strftime("%Y-%m-%d")' 2>/dev/null)"
    cat "$tmp"/*.json 2>/dev/null | jq -s --argjson b "${builds:-{\}}" --arg off "$offday" --argjson complete "$complete" 'sort_by(.day) | {currency:"USD", offDay:(if $off == "" then null else $off end), buildsComplete:$complete,
      days:map({day, total, build}),
      projects:(.[-7:] | map(.projects[]) | group_by(.name)
        | map({name:.[0].name, build:(map(.build)|add), builds:($b[.[0].name] // null)}) | sort_by(-.build))}'
    rm -rf "$tmp" ;;

  "triggers "*)
    # Builds in the last 24 h that nobody started from here, and workflows that deploy by themselves.
    since=$(( ($(date +%s) - 86400) * 1000 )); tmp="$(mktemp -d)"
    { vercel_call "/v6/deployments?limit=100&since=$since" \
        | jq -c --slurpfile r "$REPOS" '.deployments[] | select(.source=="git" or .source=="hook" or .source=="deploy-hook" or .source=="import")
            | select(.created/1000 > ($r[0][.name].offAt // 1e12))
            | {kind:"vercel-build", where:.name, detail:"source \(.source), \(.created/1000|strftime("%Y-%m-%d %H:%M")) UTC"}'
      if render_key >/dev/null 2>&1; then
        roff="$CONFIG_DIR/render-off.json"; [ -f "$roff" ] || echo '{}' > "$roff"
        for id in $(render_services | jq -r '.[] | select(.suspended!="suspended") | .id'); do
          render_call GET "/services/$id/deploys?limit=5" 2>/dev/null \
            | jq -c --arg id "$id" --argjson since "$((since/1000))" --slurpfile o "$roff" '.[].deploy
                | select(.trigger as $t | ["new_commit","deploy_hook","blueprint_sync"] | index($t))
                | select((.createdAt|sub("\\.[0-9]+Z$";"Z")|fromdateiso8601) > ([$since, ($o[0][$id] // 1e12)] | max))
                | {kind:"render-build", where:$id, detail:"trigger \(.trigger), \(.createdAt)"}' || true
        done
        render_call GET "/blueprints?limit=50" 2>/dev/null \
          | jq -c '.[].blueprint | select(.autoSync==true) | {kind:"render-blueprint", where:.name, detail:"auto-sync on"}' || true
      fi
      if command -v gh >/dev/null 2>&1; then
        { jq -r '.[] | select(.repo) | "\(.org)/\(.repo)"' "$REPOS" 2>/dev/null
          render_services 2>/dev/null | jq -r '.[] | .repo // empty | sub("^https://github.com/";"") | sub("\\.git$";"")'
        } | sort -u | xargs -P 8 -n 1 bash -c 'workflow_hits "$0" "'"$tmp"'"'
        cat "$tmp"/*.jsonl 2>/dev/null
      fi
    } | jq -s '.'
    rm -rf "$tmp" ;;

  "changed "*)
    # Everything with commits on GitHub that are not live, and how many of them.
    list="$(changed_json)"
    if [ "${2:-}" = "--json" ]; then echo "$list"; exit 0; fi
    [ "$(echo "$list" | jq length)" = "0" ] && { echo "Nothing to deploy: every project is on its newest commit."; exit 0; }
    echo "$list" | jq -r '.[] | [.platform, .name, "\(.pendingCommits // "?") commit\(if .pendingCommits == 1 then "" else "s" end)", "\(.pendingPRs // "?") PR\(if .pendingPRs == 1 then "" else "s" end)", (.headMsg // "" | .[0:60])] | @tsv' \
      | (printf 'PLATFORM\tPROJECT\tWAITING\tPRS\tNEWEST COMMIT\n'; cat) | column -t -s $'\t'
    echo "$list" | jq -r '"\(length) projects, \(map(.pendingCommits // 0) | add) commits, \(map(.pendingPRs // 0) | add) pull requests waiting."' ;;

  "deploy-changed "*)
    # The daily deploy: everything with changes. Without --yes it only shows what it would do.
    list="$(changed_json)"; n="$(echo "$list" | jq length)"
    [ "$n" = "0" ] && { echo "Nothing to deploy."; exit 0; }
    if [ "${2:-}" != "--yes" ]; then
      echo "$list" | jq -r '.[] | "  \(.platform)  \(.name)  (\(.pendingCommits // "?") commits)"'
      echo "Would deploy these $n. Run again with --yes to start them."; exit 0
    fi
    ok=0; bad=0
    while IFS=$'\t' read -r plat name id; do
      if [ "$plat" = "vercel" ]; then
        if ( vercel_deploy_json "$name" | jq -r --arg n "$name" '"Vercel: \($n) started -> \(.url)"' ); then ok=$((ok+1))
        else echo "Vercel: $name failed to start" >&2; bad=$((bad+1)); fi
      else
        if ( render_call POST "/services/$id/deploys" '{}' | jq -r --arg n "$name" '"Render: \($n) started (\(.id))"' ); then ok=$((ok+1))
        else echo "Render: $name failed to start" >&2; bad=$((bad+1)); fi
      fi
    done < <(echo "$list" | jq -r '.[] | "\(.platform)\t\(.name)\t\(.id // "")"')
    echo "$ok started, $bad failed to start."
    [ "$bad" = "0" ] ;;

  "vercel map")
    # Say by hand where a project deploys from, for one disconnected before this tool knew it.
    p="${3:?project}"; r="${4:?owner/repo}"; ref="${5:-main}"
    case "$r" in */*) ;; *) die "Give the repo as owner/name";; esac
    rid=""; command -v gh >/dev/null 2>&1 && rid="$(gh api "repos/$r" --jq .id 2>/dev/null || true)"
    tmp="$(mktemp)"
    # The whole entry is replaced: an old repoId would win over the new repo name.
    jq --arg p "$p" --arg o "${r%%/*}" --arg n "${r#*/}" --arg ref "$ref" --arg rid "$rid" \
      '.[$p] = ({org:$o, repo:$n, ref:$ref} + (if .[$p].offAt then {offAt:.[$p].offAt} else {} end)
                + (if $rid != "" then {repoId:($rid|tonumber)} else {} end))' "$REPOS" > "$tmp" && mv "$tmp" "$REPOS"
    echo "Vercel: $p deploys from $r ($ref)" ;;

  "vercel list")
    vercel_projects | jq -r '.[] | [.name, (if .link then "AUTO (\(.link.org // "")/\(.link.repo // ""))" else "manual" end)] | @tsv' \
      | column -t -s $'\t' ;;
  "vercel autodeploy-off")
    target="${3:-}"; [ -n "$target" ] || die "Give a project name or --all"
    if [ "$target" = "--all" ]; then
      for p in $(vercel_projects | jq -r '.[] | select(.link) | .name'); do vercel_off "$p"; done
      echo "Done. No Vercel project deploys on push any more."
    else
      vercel_off "$target"
    fi ;;
  "vercel deploy")
    target="${3:-}"; [ -n "$target" ] || die "Give a project name"
    vercel_deploy_json "$target" "$([ "${4:-}" = "--preview" ] && echo 1)" \
      | jq -r '"Vercel: deploy started -> \(.url) (\(.state))"' ;;
  "vercel deploy-json")
    # deploy-json <project> [--preview] [--sha <commit>]
    p="${3:?project}"; pv=""; sha=""; shift 3 || true
    while [ $# -gt 0 ]; do case "$1" in --preview) pv=1;; --sha) sha="${2:?commit}"; shift;; esac; shift; done
    vercel_deploy_json "$p" "$pv" "$sha" ;;
  "vercel cancel")
    vercel api "$(with_team "/v12/deployments/${3:?deployment id}/cancel")" --method PATCH >/dev/null 2>&1 || die "Vercel: could not cancel ${3}"
    echo '{"state":"CANCELED"}' ;;
  "vercel promote")
    # A finished preview goes live as it is, without building again.
    vercel api "$(with_team "/v10/projects/${3:?project}/promote/${4:?deployment id}")" --method POST >/dev/null 2>&1 \
      || die "Vercel: could not promote ${4} on ${3}"
    echo "{\"id\":\"${4}\",\"state\":\"READY\"}" ;;
  "vercel status")
    vercel_call "/v13/deployments/${3:?deployment id}" \
      | jq '{id, url:("https://" + .url), state:(.readyState // .status), error:(.errorMessage // null)}' ;;
  "vercel rollback")
    # Production back to the previous ready production deployment.
    p="${3:?project}"
    # "Before" means before the deployment that is live now, which after an earlier rollback or a
    # promotion is not always the newest one.
    cur="$(vercel_call "/v9/projects/$p" | jq -r '.targets.production.id // empty')"
    prev="$(vercel_call "/v6/deployments?projectId=$p&target=production&state=READY&limit=20" \
      | jq -r --arg cur "$cur" '.deployments as $d | ($d | map(.uid) | index($cur)) as $i
          | if $i == null then ($d[1].uid // empty) else ($d[$i+1].uid // empty) end')"
    [ -n "$prev" ] || die "No earlier production deployment of $p to roll back to"
    vercel api "$(with_team "/v1/projects/$p/rollback/$prev")" --method POST >/dev/null 2>&1 || die "Vercel: rollback of $p failed"
    echo "{\"id\":\"$prev\",\"state\":\"READY\"}" ;;
  "vercel team")
    if [ -n "${3:-}" ]; then printf '%s' "$3" > "$CONFIG_DIR/vercel-team"; echo "Vercel team set to $3"; else vercel_team; echo; fi ;;
  "vercel json")
    # The newest production attempt per project, from one call: a build started in the dashboard
    # or the terminal is BUILDING here while targets.production still shows the finished one.
    recent="$(vercel_call "/v6/deployments?limit=100&target=production" \
      | jq '[.deployments[]] | group_by(.name) | map({key:.[0].name, value:(max_by(.created) | {state, created})}) | from_entries' 2>/dev/null)"
    list="$(vercel_projects | jq --slurpfile r "$REPOS" --argjson recent "${recent:-{\}}" '[.[] |
      ((.link // null) | if . then {repo:"\(.org)/\(.repo)", ref:"main"} else null end) as $live |
      ($r[0][.name] // null) as $known |
      {name, auto:(.link != null),
       repo:(if $known.repo then "\($known.org)/\($known.repo)" else $live.repo end),
       ref:($known.ref // (.link.productionBranch // null)),
       deployable:($known.repo != null),
       domain:(((.targets.production.alias // []) | map(select(endswith(".vercel.app")|not)) | .[0]) // null),
       lastAt:((.targets.production.createdAt // 0) / 1000 | floor),
       lastState:(.targets.production.readyState // null),
       lastSha:(.targets.production.meta.githubCommitSha // null),
       lastMsg:(.targets.production.meta.githubCommitMessage // null | if . then split("\n")[0] else null end),
       latestState:($recent[.name].state // null)}] | sort_by(.name | ascii_downcase)')"
    echo "$list" | remember_names
    with_heads "$list" ;;

  "render list")
    render_services | jq -r '.[] | [.name, .type, '"$(render_auto)"', (if .suspended=="suspended" then "suspended" else "active" end)] | @tsv' \
      | (printf 'NAME\tTYPE\tAUTO-DEPLOY\tSTATE\n'; cat) | column -t -s $'\t' ;;
  "render autodeploy-off")
    target="${3:-}"; [ -n "$target" ] || die "Give a service name or --all"
    if [ "$target" = "--all" ]; then
      render_services | jq -r '.[] | select('"$(render_auto)"' != "off") | "\(.id)\t\(.name)"' \
        | while IFS=$'\t' read -r id name; do render_off "$id" "$name"; done
      echo "Done. No Render service deploys on push any more."
    else
      render_off "$(render_id_of "$target")" "$target"
    fi ;;
  "render deploy")
    id="$(render_id_of "${3:?service}")"
    render_call POST "/services/$id/deploys" '{}' | jq -r '"Render: deploy started (\(.id), \(.status))"' ;;
  "render deploy-json")
    # deploy-json <service> [--sha <commit>] [--clear-cache]
    id="$(render_id_of "${3:?service}")"; sha=""; cc=""; shift 3 || true
    while [ $# -gt 0 ]; do case "$1" in --sha) sha="${2:?commit}"; shift;; --clear-cache) cc=1;; esac; shift; done
    lock="$(start_lock "render-$id")"; trap 'rm -f "$lock"' EXIT
    body="$(jq -nc --arg sha "$sha" --arg cc "$cc" '(if $sha != "" then {commitId:$sha} else {} end) + (if $cc != "" then {clearCache:"clear"} else {} end)')"
    render_call POST "/services/$id/deploys" "$body" | jq --arg s "$id" '{id, serviceId:$s, state:.status}' ;;
  "render cancel")
    render_call POST "/services/${3:?service id}/deploys/${4:?deploy id}/cancel" '{}' | jq '{id, state:.status}' ;;
  "render rollback")
    # Back to the deploy that was live before the current one.
    id="$(render_id_of "${3:?service}")"
    prev="$(render_call GET "/services/$id/deploys?limit=20" | jq -r '[.[].deploy | select(.status=="deactivated")][0].id // empty')"
    [ -n "$prev" ] || die "No earlier live deploy to roll back to"
    render_call POST "/services/$id/rollback" "{\"deployId\":\"$prev\"}" | jq --arg s "$id" '{id, serviceId:$s, state:.status}' ;;
  "render status")
    render_call GET "/services/${3:?service id}/deploys/${4:?deploy id}" | jq '{id, state:.status}' ;;
  "render set-key")
    IFS= read -r key || true
    [ -n "$key" ] || die "Pipe the key in: pbpaste | deploys render set-key"
    case "$key" in *\'*|*\"*|*' '*) die "That does not look like a Render API key";; esac
    # Sent to `security -i` on stdin, so the key is never an argument anyone can see.
    printf 'add-generic-password -U -a %s -s %s -w %s\n' "$USER" "$KEYCHAIN_SERVICE" "$key" | security -i >/dev/null
    render_call GET "/services?limit=1" >/dev/null && echo "Render key saved and working." ;;
  "render json")
    list="$(render_services | jq '[.[] | {id, name, type, paused:(.suspended=="suspended"),
      auto:('"$(render_auto)"' != "off"), deployable:(.suspended!="suspended"),
      url:(.serviceDetails.url // null),
      domain:((.serviceDetails.url // "") | sub("^https?://";"") | if . == "" then null else . end),
      repo:((.repo // "") | sub("^https://github.com/";"") | sub("\\.git$";"") | if . == "" then null else . end),
      ref:(.branch // null)}] | sort_by(.name | ascii_downcase)')"
    tmp="$(mktemp -d)"; kf="$tmp/key"; (umask 077; render_key > "$kf")
    echo "$list" | jq -r '.[].id' | xargs -P 8 -n 1 bash -c 'render_last_of "$0" "'"$tmp"'" "'"$kf"'"'
    rm -f "$kf"
    lasts="$(cat "$tmp"/*.json 2>/dev/null | jq -s 'from_entries')"; rm -rf "$tmp"
    list="$(echo "$list" | jq --argjson l "${lasts:-{\}}" 'map(. + ($l[.id] // {}))')"
    with_heads "$list" ;;

  *)
    sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
