    else
      # Every project is asked in rounds, so one slow CI does not hold up the others; each starts
      # as soon as its own commit is green, at exactly that commit (a newer push waits for the next run).
      waited=0; delay=10
      while [ -n "$todo" ]; do
        t0=$SECONDS   # the asking (and starting) counts toward --wait too
        next=""
        while IFS=$'\t' read -r plat name id repo sha; do
