# compdef exists only after compinit; load it if ~/.zshrc has not.
(( \$+functions[compdef] )) || { autoload -Uz compinit && compinit; }
compdef _deploys deploys
ZSH
      ;;
      bash) cat <<BASH
_deploys() {
  local cur=\${COMP_WORDS[COMP_CWORD]}
  if [ \$COMP_CWORD -eq 1 ]; then COMPREPLY=(\$(compgen -W "$cmds" -- "\$cur"))
  elif [ \$COMP_CWORD -eq 2 ] && [ "\${COMP_WORDS[1]}" = vercel ]; then COMPREPLY=(\$(compgen -W "list deploy rollback status cancel autodeploy-off json map team" -- "\$cur"))
  elif [ \$COMP_CWORD -eq 2 ] && [ "\${COMP_WORDS[1]}" = render ]; then COMPREPLY=(\$(compgen -W "list deploy rollback status cancel autodeploy-off json set-key forget-key" -- "\$cur"))
  else COMPREPLY=(\$(compgen -W "\$(cat "$CONFIG_DIR/names" 2>/dev/null)" -- "\$cur")); fi
