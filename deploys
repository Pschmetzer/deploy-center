    recent="$(vercel_call "/v6/deployments?limit=100&target=production" \
      | jq '[.deployments[]] | group_by(.name) | map({key:.[0].name, value:(max_by(.created) | {state, created, id:.uid, sha:(.meta.githubCommitSha // null)})}) | from_entries' 2>/dev/null)"
    list="$(vercel_projects | jq --slurpfile r <(repos_json) --argjson recent "${recent:-{\}}" '[.[] |
      ((.link // null) | if . then {repo:'"$GITHOST_VERCEL_LINK_JQ"', ref:"main"} else null end) as $live |
      ($r[0][.name] // null) as $known |
      {name, auto:(.link != null),
       repo:(if $known.repo then (if $known.type == "gitlab" then $known.repo else "\($known.org)/\($known.repo)" end) else $live.repo end),
       ref:($known.ref // (.link.productionBranch // null)),
       deployable:($known.repo != null),
       domain:(((.targets.production.alias // []) | map(select(endswith(".vercel.app")|not)) | .[0]) // null),
       lastAt:((.targets.production.createdAt // 0) / 1000 | floor),
       lastState:(.targets.production.readyState // null),
       lastSha:(.targets.production.meta.githubCommitSha // null),
       lastMsg:(.targets.production.meta.githubCommitMessage // null | if . then split("\n")[0] else null end),
       latestState:($recent[.name].state // null),
       latestId:($recent[.name].id // null), latestSha:($recent[.name].sha // null)}] | sort_by(.name | ascii_downcase)')"
    echo "$list" | remember_names
    with_heads "$list" ;;

  "render list")
    render_services | jq -r '.[] | [.name, .type, '"$(render_auto)"', (if .suspended=="suspended" then "suspended" else "active" end)] | @tsv' \
      | (printf 'NAME\tTYPE\tAUTO-DEPLOY\tSTATE\n'; cat) | column -t -s $'\t' ;;
  "render autodeploy-off")
    target="${3:-}"; [ -n "$target" ] || die "Give a service name or --all"
    if [ "$target" = "--all" ]; then
      bad=0; todo="$(render_services | jq -r '.[] | select('"$(render_auto)"' != "off") | "\(.id)\t\(.name)"')"
      while IFS=$'\t' read -r id name; do
        [ -n "$id" ] || continue; ( render_off "$id" "$name" ) || bad=$((bad + 1))
      done <<< "$todo"
      [ "$bad" = 0 ] || die "$bad Render services could not be switched off (see above); the others are done"
