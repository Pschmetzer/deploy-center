    offday="$( { jq '[.[] | .offAt? // empty]' "$REPOS"; jq '[.[]]' "$CONFIG_DIR/render-off.json" 2>/dev/null || echo '[]'; } \
      | jq -rs 'add | map(select(type=="number")) | min // empty | strftime("%Y-%m-%d")' 2>/dev/null)"
    [ -n "$builds" ] || builds='{}'
    cat_all "$tmp"/*.json | jq -s --argjson b "$builds" --arg off "$offday" --argjson complete "$complete" 'sort_by(.day) | {currency:"USD", offDay:(if $off == "" then null else $off end), buildsComplete:$complete,
      days:map({day, total, build}),
      projects:(.[-7:] | map(.projects[]) | group_by(.name)
