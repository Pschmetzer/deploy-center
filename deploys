      win=""
      [ -z "$did" ] || win="$(render_call GET "/services/$id/deploys/$did" | jq -r '"&startTime=\(.createdAt | @uri)" + (if .finishedAt then "&endTime=\(.finishedAt | @uri)" else "" end)')"
      render_call GET "/logs?ownerId=$owner&resource=$id&type=build&limit=$n&direction=backward$win" \
        | jq -r '.logs | reverse | .[].message' | sed $'s/\x1b\\[[0-9;]*m//g'
    fi ;;

  "open "*)
    # The site, or with --dashboard the project's page at Vercel or Render.
    p="${2:?project}"; plat="$(platform_of "$p")"
    if [ "$plat" = vercel ]; then
      if [ "${3:-}" = "--dashboard" ]; then
        # A team's page is under its slug, a personal account's under the user name.
        if [ -n "$(vercel_team)" ]; then slug="$(vercel_call "/v2/teams/$(vercel_team)" | jq -r '.slug // empty' 2>/dev/null || true)"
        else slug="$(vercel_call "/v2/user" | jq -r '.user.username // empty' 2>/dev/null || true)"; fi
