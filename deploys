      zsh) cat <<ZSH
_deploys() {
  local -a names; names=(\${(f)"\$(cat "$CONFIG_DIR/names" 2>/dev/null)"})
  if (( CURRENT == 2 )); then compadd $cmds
${zv}  elif [[ \$words[2] == ai && CURRENT == 3 ]]; then compadd explain notes ship set-key forget-key verify model cap status
  elif [[ \$words[2] == providers && CURRENT == 3 ]]; then compadd enable disable
  elif [[ \$words[2] == completion ]]; then compadd zsh bash fish
